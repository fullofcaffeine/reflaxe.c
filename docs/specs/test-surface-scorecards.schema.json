{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflaxe.c.dev/schemas/test-surface-scorecards.schema.json",
  "title": "reflaxe.c product-surface test scorecards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "capabilityAuthority",
    "policyOnlyOwners",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/path"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "const": "hxc-test-surfaces-v1"
    },
    "capabilityAuthority": {
      "const": "docs/specs/bootstrap-inventory.json"
    },
    "policyOnlyOwners": {
      "$ref": "#/$defs/strings"
    },
    "surfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "proves",
        "doesNotProve"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "proves": {
          "type": "string",
          "minLength": 1
        },
        "doesNotProve": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "archetype",
        "status",
        "ownerBeads",
        "protectedClaims",
        "capabilityIds",
        "focusedOwners",
        "verticalOwners",
        "systemOwners",
        "affectedExtendedOwners",
        "oracles",
        "evidence",
        "selectorOwnership",
        "fullBackstopCommand",
        "releaseCommand",
        "lastObserved",
        "residualRisks"
      ],
      "properties": {
        "id": {
          "enum": [
            "compiler-admitted-slices",
            "c-abi-native-ffi",
            "runtime-memory-lifetime",
            "toolchain-platform-portability",
            "diagnostics-source-mapping-downstream"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "enum": [
            "compiler",
            "native-metal",
            "runtime",
            "portability",
            "diagnostics-downstream"
          ]
        },
        "status": {
          "enum": [
            "admitted-slice",
            "partial",
            "unsupported"
          ]
        },
        "ownerBeads": {
          "$ref": "#/$defs/strings"
        },
        "protectedClaims": {
          "$ref": "#/$defs/strings"
        },
        "capabilityIds": {
          "$ref": "#/$defs/strings"
        },
        "focusedOwners": {
          "$ref": "#/$defs/strings"
        },
        "verticalOwners": {
          "$ref": "#/$defs/strings"
        },
        "systemOwners": {
          "$ref": "#/$defs/strings"
        },
        "affectedExtendedOwners": {
          "$ref": "#/$defs/strings"
        },
        "oracles": {
          "$ref": "#/$defs/strings"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "selectorOwnership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticOwners",
            "affectedRing",
            "unknownFallback"
          ],
          "properties": {
            "semanticOwners": {
              "$ref": "#/$defs/strings"
            },
            "affectedRing": {
              "const": "R3"
            },
            "unknownFallback": {
              "const": "R4"
            }
          }
        },
        "fullBackstopCommand": {
          "type": "string",
          "minLength": 1
        },
        "releaseCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastObserved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "evidence"
          ],
          "properties": {
            "state": {
              "enum": [
                "bounded-green",
                "known-red",
                "not-qualified"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "residualRisks": {
          "$ref": "#/$defs/strings"
        }
      }
    }
  }
}
