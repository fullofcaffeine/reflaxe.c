{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflaxe.c.dev/schemas/fixture-case.schema.json",
  "title": "reflaxe.c fixture or example case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "role",
    "type",
    "status",
    "sources",
    "runner",
    "expected"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "enum": [
        "fixture",
        "example"
      ]
    },
    "type": {
      "enum": [
        "positive",
        "negative",
        "ast",
        "snapshot",
        "runtime",
        "differential",
        "abi",
        "performance"
      ]
    },
    "status": {
      "enum": [
        "active",
        "planned",
        "disabled"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HXC-[A-Z]+-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "productSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/productSurface"
      },
      "uniqueItems": true
    },
    "behaviorScenario": {
      "$ref": "#/$defs/behaviorScenario"
    },
    "oracleProvenance": {
      "$ref": "#/$defs/oracleProvenance"
    },
    "tracerBullet": {
      "$ref": "#/$defs/tracerBullet"
    },
    "example": {
      "$ref": "#/$defs/example"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "workingDirectory",
        "timeoutSeconds",
        "network"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "network": {
          "type": "boolean"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode"
      ],
      "minProperties": 2,
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "stdout": {
          "$ref": "#/$defs/streamAssertion"
        },
        "stderr": {
          "$ref": "#/$defs/streamAssertion"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^HXC[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "comparison"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "format": {
                "enum": [
                  "text",
                  "json",
                  "c",
                  "header",
                  "hxcir",
                  "binary",
                  "metrics"
                ]
              },
              "comparison": {
                "enum": [
                  "exact",
                  "semantic-json",
                  "symbols",
                  "layout",
                  "budget"
                ]
              }
            }
          }
        },
        "runtimePlan": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "$ref": "#/$defs/inlineRuntimePlan"
            }
          ]
        },
        "oracle": {
          "$ref": "#/$defs/relativePath"
        },
        "metrics": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "anyOf": [
        {
          "required": [
            "stdout"
          ]
        },
        {
          "required": [
            "stderr"
          ]
        },
        {
          "required": [
            "diagnostics"
          ]
        },
        {
          "required": [
            "artifacts"
          ]
        },
        {
          "required": [
            "runtimePlan"
          ]
        },
        {
          "required": [
            "oracle"
          ]
        },
        {
          "required": [
            "metrics"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "example"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "productSurfaces",
          "behaviorScenario",
          "oracleProvenance",
          "example"
        ]
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "productSurface": {
      "enum": [
        "compiler-admitted-slices",
        "c-abi-native-ffi",
        "runtime-memory-lifetime",
        "toolchain-platform-portability",
        "diagnostics-source-mapping-downstream"
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "behaviorScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preconditions",
        "action",
        "observableResult",
        "edgeBehavior",
        "protectedClaim"
      ],
      "properties": {
        "preconditions": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "observableResult": {
          "type": "string",
          "minLength": 1
        },
        "edgeBehavior": {
          "type": "string",
          "minLength": 1
        },
        "protectedClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oracleProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "independence",
        "reviewRule"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "manual-expectation",
            "pinned-differential-reference",
            "invariant",
            "reviewed-golden",
            "real-consumer"
          ]
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "independence": {
          "type": "string",
          "minLength": 1
        },
        "reviewRule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracerBullet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "path"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "owner",
        "executionKind",
        "compilerToolchains",
        "platformAssumptions",
        "runtimeExpectation",
        "sanitizerRelevance",
        "advertisedClaim"
      ],
      "properties": {
        "tier": {
          "enum": [
            "flagship-application",
            "capability-showcase",
            "compile-only-snippet"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^test:[a-z0-9][a-z0-9:-]*$"
        },
        "executionKind": {
          "enum": [
            "portable",
            "native-metal",
            "mixed"
          ]
        },
        "compilerToolchains": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "platformAssumptions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "runtimeExpectation": {
          "type": "string",
          "minLength": 1
        },
        "sanitizerRelevance": {
          "type": "string",
          "minLength": 1
        },
        "advertisedClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inlineRuntimePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "features"
      ],
      "properties": {
        "policy": {
          "enum": [
            "auto",
            "minimal",
            "none"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "streamAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "empty",
            "exact",
            "contains",
            "regex",
            "json"
          ]
        },
        "value": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "empty"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "exact",
                "contains",
                "regex",
                "json"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "path"
              ]
            }
          ]
        }
      ]
    }
  }
}
