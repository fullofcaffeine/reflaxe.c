{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflaxe-c.dev/schemas/hxc-inspect-report.schema.json",
  "title": "hxc inspect schema-1 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "report",
    "redacted",
    "manifest",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "report": {
      "enum": [
        "manifest",
        "config",
        "typed-inventory",
        "hxcir",
        "c-ast",
        "lowering",
        "runtime",
        "symbols",
        "includes",
        "build",
        "declarations",
        "macros",
        "stdlib",
        "abi",
        "sizes",
        "all"
      ]
    },
    "redacted": {
      "type": "boolean"
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "data": true
  }
}
