{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haxe.c.dev/schemas/hxc-bindings-lock.schema.json",
  "title": "hxc Clang semantic binding lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "generator",
    "toolchain",
    "configuration",
    "configurationSha256",
    "invocation",
    "inputs",
    "inputSetSha256",
    "semanticModel",
    "semanticSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "authority": { "const": "clang-ast-json" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model"],
      "properties": {
        "name": { "const": "hxc-bindgen" },
        "model": { "const": "clang-semantic-translation-unit-v2" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "version", "dumpMachine", "resourceDirectory"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "dumpMachine": { "type": "string", "minLength": 1 },
        "resourceDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective", "provenance"],
      "properties": {
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entryHeaders", "language", "target", "sysroot", "includeDirectories", "defines"],
          "properties": {
            "entryHeaders": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "language": { "enum": ["c", "c++"] },
            "target": { "type": "string", "minLength": 1 },
            "sysroot": { "type": ["string", "null"] },
            "includeDirectories": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "defines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                  "value": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entryHeaders", "language", "target", "sysroot", "includeDirectories", "defines"],
          "properties": {
            "entryHeaders": { "const": "command-line" },
            "language": { "enum": ["default", "command-line"] },
            "target": { "enum": ["clang-default", "command-line"] },
            "sysroot": { "enum": ["absent", "command-line"] },
            "includeDirectories": { "enum": ["absent", "command-line"] },
            "defines": { "enum": ["absent", "command-line"] }
          }
        }
      }
    },
    "configurationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosticArguments", "semanticArguments", "dependencyArguments"],
      "properties": {
        "diagnosticArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "semanticArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dependencyArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "inputSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "declarationCount", "translationUnit"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "declarationCount": { "type": "integer", "minimum": 0 },
        "translationUnit": {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "TranslationUnitDecl" } }
        }
      }
    },
    "semanticSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
