{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haxe.c.dev/schemas/hxc-bindings-lock.schema.json",
  "title": "hxc Clang semantic binding lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "generator",
    "toolchain",
    "invocation",
    "inputs",
    "inputSetSha256",
    "semanticModel",
    "semanticSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authority": { "const": "clang-ast-json" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model"],
      "properties": {
        "name": { "const": "hxc-bindgen" },
        "model": { "const": "clang-semantic-translation-unit-v1" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "version", "dumpMachine", "resourceDirectory"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "dumpMachine": { "type": "string", "minLength": 1 },
        "resourceDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "language", "target", "diagnosticArguments", "semanticArguments", "dependencyArguments"],
      "properties": {
        "header": { "type": "string", "minLength": 1 },
        "language": { "const": "c" },
        "target": { "type": "string", "minLength": 1 },
        "diagnosticArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "semanticArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dependencyArguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "inputSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "declarationCount", "translationUnit"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "declarationCount": { "type": "integer", "minimum": 0 },
        "translationUnit": {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "TranslationUnitDecl" } }
        }
      }
    },
    "semanticSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
