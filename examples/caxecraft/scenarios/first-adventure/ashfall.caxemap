CAXEMAP 1
feature required caxecraft:core
map adventure.ashfall
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "RESTORE THE ASHFALL BRIDGE"
  message adventure_tagline "REPAIR BOTH SUPPORTS. FORGE THE SPAN. LIGHT ITS BEACON."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "BERRIES FULL: USE ONE FIRST"
  message block_stack_full "BLOCK STACK FULL: USE ONE FIRST"
  message bridge_open "THE ASHFALL SPAN ANSWERS. THE ROAD TO BROWSER'S CASTLE IS OPEN."
  message castle_body "BEYOND THE RESTORED SPAN, BLACK STONE TEETH FRAME BROWSER'S CASTLE ROAD. CEESH IS SOMEWHERE PAST THAT GATE."
  message castle_title "THE CASTLE ROAD"
  message enemy_alert "ASH MOSSLING ALERT"
  message enemy_dropped_items "MOSSLING DROPPED BERRIES"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "MOSSLING WINDUP: DODGE"
  message forge_early "THE BRIDGE FORGE NEEDS BOTH SUPPORTS: OPEN THE RIVER SLUICE AND LOCK THE ROOT BRACE."
  message forge_ready "BOTH SUPPORTS HOLD. THE HAXEFORGE SHAPES A SAFE SPAN TO THE BEACON."
  message guide_talk "E  TALK"
  message nia_welcome "NIA: BROWSER BROKE THE ASHFALL SPAN. OPEN THE EAST RIVER SLUICE AND LOCK THE WEST ROOT BRACE. THEN USE THE BRIDGE FORGE AND LIGHT ITS BEACON."
  message object_use "E  USE"
  message objective_anchors_body "OPEN THE RIVER SLUICE ON THE EAST SUPPORT AND LOCK THE ROOT BRACE ON THE WEST. EITHER MAY COME FIRST."
  message objective_anchors_title "REPAIR THE TWO BRIDGE SUPPORTS"
  message objective_castle_body "CROSS THE RESTORED SPAN AND READ THE CASTLE ROAD MARKER."
  message objective_castle_title "REACH THE CASTLE ROAD"
  message objective_finish_body "BOTH SUPPORTS HOLD. USE THE CENTRAL BRIDGE FORGE, THEN LIGHT THE BEACON BESIDE THE SPAN."
  message objective_finish_title "FORGE THE SPAN AND LIGHT ITS BEACON"
  message objective_nia_body "NIA WAITS AT THE SNOWLINE SHELTER."
  message objective_nia_title "ASK NIA ABOUT THE BROKEN SPAN"
  message reset "THE EARLY BEACON PULSE RELEASES BOTH UNFINISHED SUPPORTS. SET THE SLUICE AND BRACE AGAIN, THEN FORGE THE SPAN."
  message reward "AN ASHFALL ROADWORKER LEFT BREAD HERE FOR THE CASTLE CLIMB."
  message road_cache_body "A SOOT-DARK ROADWORKER DOOR HIDES A SMALL SUPPLY NOOK WEST OF THE CASTLE ROAD. ITS BREAD IS OPTIONAL, BUT USEFUL BEFORE THE CLIMB."
  message road_cache_open "THE ROADWORKER CACHE OPENS. BREAD WAITS INSIDE."
  message road_cache_title "ASHFALL ROADWORKER CACHE"
  message root_ready "THE WEST ROOT BRACE LOCKS. OPEN THE EAST RIVER SLUICE."
  message scenario_title "Caxecraft: Ashfall Bridge"
  message wave_ready "THE EAST RIVER SLUICE OPENS. LOCK THE WEST ROOT BRACE."
end locale
locale es-mx
  message adventure_progress "RESTAURA EL PUENTE DE ASHFALL"
  message adventure_tagline "REPARA DOS SOPORTES. FORJA EL TRAMO. ENCIENDE SU FARO."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "BAYAS LLENAS: USA UNA PRIMERO"
  message block_stack_full "PILA DE BLOQUES LLENA: USA UNO"
  message bridge_open "EL TRAMO DE ASHFALL RESPONDE. EL CAMINO AL CASTILLO DE BROWSER ESTA ABIERTO."
  message castle_body "TRAS EL PUENTE, DIENTES DE PIEDRA NEGRA MARCAN EL CAMINO AL CASTILLO DE BROWSER. CEESH ESTA MAS ALLA."
  message castle_title "EL CAMINO AL CASTILLO"
  message enemy_alert "MUSGUITO DE CENIZA ALERTA"
  message enemy_dropped_items "EL MUSGUITO SOLTO BAYAS"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "MUSGUITO CARGANDO: ESQUIVA"
  message forge_early "LA FORJA DEL PUENTE NECESITA DOS SOPORTES: ABRE LA COMPUERTA DEL RIO Y FIJA EL REFUERZO DE RAIZ."
  message forge_ready "LOS DOS SOPORTES RESISTEN. LA HAXEFORGE FORMA UN TRAMO SEGURO HASTA EL FARO."
  message guide_talk "E  HABLAR"
  message nia_welcome "NIA: BROWSER ROMPIO EL TRAMO DE ASHFALL. ABRE LA COMPUERTA DEL RIO AL ESTE Y FIJA EL REFUERZO DE RAIZ AL OESTE. LUEGO USA LA FORJA DEL PUENTE Y ENCIENDE SU FARO."
  message object_use "E  USAR"
  message objective_anchors_body "ABRE LA COMPUERTA DEL RIO EN EL SOPORTE ESTE Y FIJA EL REFUERZO DE RAIZ AL OESTE. PUEDES EMPEZAR POR CUALQUIERA."
  message objective_anchors_title "REPARA LOS DOS SOPORTES DEL PUENTE"
  message objective_castle_body "CRUZA EL PUENTE RESTAURADO Y LEE LA MARCA DEL CAMINO AL CASTILLO."
  message objective_castle_title "LLEGA AL CAMINO DEL CASTILLO"
  message objective_finish_body "LOS DOS SOPORTES RESISTEN. USA LA FORJA CENTRAL Y ENCIENDE EL FARO JUNTO AL TRAMO."
  message objective_finish_title "FORJA EL TRAMO Y ENCIENDE SU FARO"
  message objective_nia_body "NIA ESPERA EN EL REFUGIO DEL LIMITE DE NIEVE."
  message objective_nia_title "PREGUNTA A NIA POR EL PUENTE ROTO"
  message reset "EL PULSO PREMATURO DEL FARO SUELTA LOS SOPORTES INCOMPLETOS. AJUSTA LA COMPUERTA Y EL REFUERZO OTRA VEZ."
  message reward "UN CAMINERO DE ASHFALL DEJO PAN AQUI PARA LA SUBIDA AL CASTILLO."
  message road_cache_body "UNA PUERTA OSCURA DE HOLLIN ESCONDE UN PEQUENO DEPOSITO AL OESTE DEL CAMINO AL CASTILLO. EL PAN ES OPCIONAL, PERO UTIL PARA LA SUBIDA."
  message road_cache_open "EL DEPOSITO DEL CAMINERO SE ABRE. HAY PAN ADENTRO."
  message road_cache_title "DEPOSITO DEL CAMINERO DE ASHFALL"
  message root_ready "EL REFUERZO DE RAIZ OESTE QUEDA FIJO. ABRE LA COMPUERTA DEL RIO AL ESTE."
  message scenario_title "Caxecraft: Puente de Ashfall"
  message wave_ready "LA COMPUERTA DEL RIO AL ESTE SE ABRE. FIJA EL REFUERZO DE RAIZ AL OESTE."
end locale
title message scenario_title
mode adventure
