fluid ash.cooling-pool caxecraft:water volume 21 6 22 4 1 3
object ash.bridge-beacon
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 16500 5000 13500 0
end object
object ash.bridge-forge
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 16500 5000 17500 0
end object
object ash.bridge-gate
  tag mechanism
  placement stateful caxecraft:vault-gate caxecraft:sealed 16500 5000 10500 0
end object
object ash.castle-gate
  tag landmark
  placement stateful caxecraft:vault-gate caxecraft:sealed 16500 6000 2500 0
end object
object ash.river-sluice
  tag mechanism
  placement stateful caxecraft:gate-winch caxecraft:waiting 24500 6000 21500 270
end object
object ash.roadworker-cache
  tag secret
  placement stateful caxecraft:vault-gate caxecraft:sealed 6500 6000 8500 90
end object
object ash.root-brace
  tag mechanism
  placement stateful caxecraft:gate-winch caxecraft:waiting 7500 6000 21500 90
end object
object enemy.ash-mossling
  tag enemy
  placement entity caxecraft:mossling 25500 6000 21500 180
end object
object guide.nia
  tag friend
  placement npc caxecraft:nia dialogue.nia.ashfall 15000 5000 26500 180
end object
object item.castle-bread
  tag reward
  placement item caxecraft:bread 1 4500 6000 8500 0
end object
object player.start
  tag player
  placement player-spawn 16500 5000 28500 0
end object
object zone.castle-road
  tag destination
  placement trigger-zone 10 4 0 12 8 9
end object
speaker guide.nia name message speaker_nia_name
dialogue dialogue.beacon.open
  line speaker guide.nia message bridge_open
end dialogue
dialogue dialogue.beacon.reset
  line speaker guide.nia message reset
end dialogue
dialogue dialogue.bridge-forge.early
  line speaker guide.nia message forge_early
end dialogue
dialogue dialogue.bridge-forge.ready
  line speaker guide.nia message forge_ready
end dialogue
dialogue dialogue.nia.ashfall
  line speaker guide.nia message nia_welcome
end dialogue
dialogue dialogue.reward
  line speaker guide.nia message reward
end dialogue
dialogue dialogue.roadworker-cache
  line speaker guide.nia message road_cache_open
end dialogue
dialogue dialogue.support.river
  line speaker guide.nia message wave_ready
end dialogue
dialogue dialogue.support.root
  line speaker guide.nia message root_ready
end dialogue
journal journal.castle-road title message castle_title
  body message castle_body
end journal
journal journal.roadworker-cache title message road_cache_title
  body message road_cache_body
end journal
objective objective.ask-nia active title message objective_nia_title
  body message objective_nia_body
end objective
objective objective.cool-anchors hidden title message objective_anchors_title
  body message objective_anchors_body
end objective
objective objective.finish-bridge hidden title message objective_finish_title
  body message objective_finish_body
end objective
objective objective.reach-castle-road hidden title message objective_castle_title
  body message objective_castle_body
end objective
variable quest.river-sluice-ready quest flag false
variable quest.root-brace-ready quest flag false
variable quest.span-forged quest flag false
rule rule.beacon-opens-the-span priority 100 once
  when interact ash.bridge-beacon
  if (flag quest.span-forged true)
  do set-object-state ash.bridge-beacon caxecraft:entered
  do set-object-state ash.bridge-gate caxecraft:open
  do dialogue dialogue.beacon.open
  do objective objective.finish-bridge complete
  do objective objective.reach-castle-road active
end rule
rule rule.beacon-resets-unfinished-supports priority 90 repeat
  when interact ash.bridge-beacon
  if (flag quest.span-forged false)
  do set-flag quest.root-brace-ready false
  do set-flag quest.river-sluice-ready false
  do set-object-state ash.root-brace caxecraft:waiting
  do set-object-state ash.river-sluice caxecraft:waiting
  do dialogue dialogue.beacon.reset
end rule
rule rule.both-supports-point-to-forge priority 80 once
  when state-changed quest.river-sluice-ready
  if (all (flag quest.river-sluice-ready true) (flag quest.root-brace-ready true))
  do objective objective.cool-anchors complete
  do objective objective.finish-bridge active
end rule
rule rule.both-supports-point-to-forge-reversed priority 80 once
  when state-changed quest.root-brace-ready
  if (all (flag quest.river-sluice-ready true) (flag quest.root-brace-ready true))
  do objective objective.cool-anchors complete
  do objective objective.finish-bridge active
end rule
rule rule.bridge-forge-needs-both-supports priority 90 repeat
  when interact ash.bridge-forge
  if (not (all (flag quest.river-sluice-ready true) (flag quest.root-brace-ready true)))
  do dialogue dialogue.bridge-forge.early
end rule
rule rule.bridge-forge-shapes-the-span priority 100 once
  when interact ash.bridge-forge
  if (all (flag quest.river-sluice-ready true) (flag quest.root-brace-ready true))
  do set-flag quest.span-forged true
  do set-object-state ash.bridge-forge caxecraft:entered
  do dialogue dialogue.bridge-forge.ready
end rule
rule rule.castle-road-recorded priority 100 once
  when enter-zone zone.castle-road
  if (objective objective.reach-castle-road active)
  do journal journal.castle-road
  do dialogue dialogue.reward
  do objective objective.reach-castle-road complete
  do campaign-exit ashfall-castle-road
end rule
rule rule.nia-explains-the-span priority 100 once
  when interact guide.nia
  if (objective objective.ask-nia active)
  do dialogue dialogue.nia.ashfall
  do objective objective.ask-nia complete
  do objective objective.cool-anchors active
end rule
rule rule.river-sluice-opens priority 100 repeat
  when interact ash.river-sluice
  if (flag quest.river-sluice-ready false)
  do set-flag quest.river-sluice-ready true
  do set-object-state ash.river-sluice caxecraft:entered
  do dialogue dialogue.support.river
end rule
rule rule.roadworker-cache-opens priority 100 once
  when interact ash.roadworker-cache
  if (object-state ash.roadworker-cache caxecraft:sealed)
  do set-object-state ash.roadworker-cache caxecraft:open
  do dialogue dialogue.roadworker-cache
  do journal journal.roadworker-cache
end rule
rule rule.root-brace-locks priority 100 repeat
  when interact ash.root-brace
  if (flag quest.root-brace-ready false)
  do set-flag quest.root-brace-ready true
  do set-object-state ash.root-brace caxecraft:entered
  do dialogue dialogue.support.root
end rule
end-map
