CAXEMAP 1
feature required caxecraft:core
map adventure.ashfall
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "FIX THE ASHFALL BRIDGE"
  message adventure_tagline "FIX BOTH SIDES. USE THE HAXEFORGE. LIGHT THE BEACON."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "NO ROOM FOR MORE BERRIES: USE ONE FIRST"
  message block_stack_full "NO ROOM FOR MORE BLOCKS: USE ONE FIRST"
  message bridge_open "THE ASHFALL BRIDGE IS READY. THE ROAD TO BROWSER'S CASTLE IS OPEN."
  message castle_body "BLACK STONE MARKS THE ROAD TO BROWSER'S CASTLE. CEESH IS SOMEWHERE PAST THE GATE."
  message castle_title "THE CASTLE ROAD"
  message enemy_alert "ASH MOSSLING ALERT"
  message enemy_dropped_items "MOSSLING DROPPED BERRIES"
  message enemy_hit_warning "ATTACK COMING: DODGE"
  message enemy_windup "MOSSLING GETS READY: DODGE"
  message forge_early "THE HAXEFORGE NEEDS BOTH SIDES. OPEN THE EAST WATER GATE AND LOCK THE WEST ROOT SUPPORT."
  message forge_ready "BOTH SIDES ARE READY. THE HAXEFORGE BUILDS A SAFE BRIDGE TO THE BEACON."
  message guide_talk "E  TALK"
  message nia_welcome "BROWSER BROKE THE BRIDGE. LOCK THE WEST ROOT SUPPORT AND OPEN THE EAST WATER GATE."
  message object_use "E  USE"
  message objective_anchors_body "OPEN THE EAST WATER GATE. LOCK THE WEST ROOT SUPPORT. YOU CAN USE EITHER ONE FIRST."
  message objective_anchors_title "FIX BOTH SIDES OF THE BRIDGE"
  message objective_castle_body "CROSS THE FIXED BRIDGE AND READ THE CASTLE ROAD SIGN."
  message objective_castle_title "REACH THE CASTLE ROAD"
  message objective_finish_body "BOTH SIDES ARE READY. USE THE HAXEFORGE. THEN LIGHT THE BEACON BY THE BRIDGE."
  message objective_finish_title "BUILD THE BRIDGE AND LIGHT THE BEACON"
  message objective_nia_body "NIA WAITS WHERE THE SNOW ENDS."
  message objective_nia_title "ASK NIA ABOUT THE BROKEN BRIDGE"
  message reset "THE BEACON WAS TOO EARLY. BOTH SIDES RESET. SET THEM AGAIN, THEN USE THE HAXEFORGE."
  message reward "AN ASHFALL WORKER LEFT BREAD HERE FOR THE CLIMB."
  message road_cache_body "A BLACK WORKER DOOR HIDES A SMALL FOOD ROOM WEST OF THE CASTLE ROAD. THE BREAD CAN HELP ON THE CLIMB."
  message road_cache_open "THE HIDDEN ROOM OPENS. BREAD WAITS INSIDE."
  message road_cache_title "HIDDEN ASHFALL FOOD"
  message root_ready "THE WEST ROOT SUPPORT LOCKS. OPEN THE EAST WATER GATE."
  message scenario_title "Caxecraft: Ashfall Bridge"
  message speaker_nia_name "Nia"
  message wave_ready "THE EAST WATER GATE OPENS. LOCK THE WEST ROOT SUPPORT."
end locale
locale es-mx
  message adventure_progress "ARREGLA EL PUENTE DE ASHFALL"
  message adventure_tagline "ARREGLA LOS DOS LADOS. USA LA HAXEFORGE. ENCIENDE EL FARO."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "NO CABEN MÁS BAYAS: USA UNA PRIMERO"
  message block_stack_full "NO CABEN MÁS BLOQUES: USA UNO PRIMERO"
  message bridge_open "EL PUENTE DE ASHFALL ESTÁ LISTO. EL CAMINO AL CASTILLO DE BROWSER ESTÁ ABIERTO."
  message castle_body "LA PIEDRA NEGRA MARCA EL CAMINO AL CASTILLO DE BROWSER. CEESH ESTÁ DESPUÉS DE LA PUERTA."
  message castle_title "EL CAMINO AL CASTILLO"
  message enemy_alert "MUSGUITO DE CENIZA ALERTA"
  message enemy_dropped_items "EL MUSGUITO SOLTÓ BAYAS"
  message enemy_hit_warning "VIENE UN ATAQUE: ESQUIVA"
  message enemy_windup "EL MUSGUITO SE PREPARA: ESQUIVA"
  message forge_early "LA HAXEFORGE NECESITA LOS DOS LADOS. ABRE LA PUERTA DEL AGUA AL ESTE Y FIJA EL SOPORTE DE RAÍZ AL OESTE."
  message forge_ready "LOS DOS LADOS ESTÁN LISTOS. LA HAXEFORGE CONSTRUYE UN PUENTE SEGURO HASTA EL FARO."
  message guide_talk "E  HABLAR"
  message nia_welcome "BROWSER ROMPIÓ EL PUENTE. FIJA EL SOPORTE DE RAÍZ AL OESTE Y ABRE LA PUERTA DEL AGUA AL ESTE."
  message object_use "E  USAR"
  message objective_anchors_body "ABRE LA PUERTA DEL AGUA AL ESTE. FIJA EL SOPORTE DE RAÍZ AL OESTE. PUEDES USAR CUALQUIERA PRIMERO."
  message objective_anchors_title "ARREGLA LOS DOS LADOS DEL PUENTE"
  message objective_castle_body "CRUZA EL PUENTE Y LEE EL LETRERO DEL CAMINO AL CASTILLO."
  message objective_castle_title "LLEGA AL CAMINO DEL CASTILLO"
  message objective_finish_body "LOS DOS LADOS ESTÁN LISTOS. USA LA HAXEFORGE. DESPUÉS ENCIENDE EL FARO JUNTO AL PUENTE."
  message objective_finish_title "CONSTRUYE EL PUENTE Y ENCIENDE EL FARO"
  message objective_nia_body "NIA ESPERA DONDE TERMINA LA NIEVE."
  message objective_nia_title "PREGUNTA A NIA POR EL PUENTE ROTO"
  message reset "ENCENDISTE EL FARO MUY PRONTO. LOS DOS LADOS SE REINICIAN. AJÚSTALOS Y USA LA HAXEFORGE."
  message reward "UN TRABAJADOR DE ASHFALL DEJÓ PAN AQUÍ PARA LA SUBIDA."
  message road_cache_body "UNA PUERTA NEGRA ESCONDE UN CUARTO CON COMIDA AL OESTE DEL CAMINO. EL PAN PUEDE AYUDAR EN LA SUBIDA."
  message road_cache_open "EL CUARTO SE ABRE. HAY PAN ADENTRO."
  message road_cache_title "COMIDA ESCONDIDA EN ASHFALL"
  message root_ready "EL SOPORTE DE RAÍZ AL OESTE QUEDA FIJO. ABRE LA PUERTA DEL AGUA AL ESTE."
  message scenario_title "Caxecraft: Puente de Ashfall"
  message speaker_nia_name "Nia"
  message wave_ready "LA PUERTA DEL AGUA AL ESTE SE ABRE. FIJA EL SOPORTE DE RAÍZ AL OESTE."
end locale
title message scenario_title
mode adventure
