object enemy.south-wisp
  tag enemy
  tag hazard
  placement entity caxecraft:ember-wisp 37500 8000 22500 270
end object
object guide.fallskeeper
  tag friend
  placement npc caxecraft:fallskeeper dialogue.fallskeeper.ruins 6500 5000 18500 270
end object
object item.air-pocket-cache
  tag discovery
  tag reward
  placement item caxecraft:berries 4 34500 6000 3500 180
end object
object item.tideweave-safety-station
  tag quest
  tag recovery
  placement item caxecraft:tideweave-suit 1 7500 5000 16500 90
end object
object landmark.air-pocket-note
  tag discovery
  tag lore
  placement stateful caxecraft:ceesh-field-note caxecraft:waiting 26500 6000 3500 90
end object
object player.start
  tag player
  placement player-spawn 4500 5000 16500 90
end object
object ruins.castle-sluice
  tag mechanism
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 49500 3000 16500 90
end object
object ruins.tide-lock
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 44500 3000 12500 180
end object
object zone.air-pocket
  tag recovery
  tag secret
  placement trigger-zone 23 5 1 16 6 5
end object
object zone.castle-drain
  tag destination
  placement trigger-zone 58 4 12 6 8 9
end object
object zone.nave-arrival
  tag landmark
  placement trigger-zone 8 2 12 5 7 9
end object
speaker guide.fallskeeper name message speaker_fallskeeper_name
dialogue dialogue.air-pocket
  line narrator message air_pocket_body
end dialogue
dialogue dialogue.arrival
  line narrator message arrival_body
end dialogue
dialogue dialogue.castle-drain
  line narrator message exit_body
end dialogue
dialogue dialogue.fallskeeper.ruins
  line speaker guide.fallskeeper message fallskeeper_ruins
end dialogue
dialogue dialogue.tide-lock
  line narrator message tide_lock_body
end dialogue
dialogue dialogue.tideweave-station
  line speaker guide.fallskeeper message tideweave_station
end dialogue
journal journal.air-pocket title message air_pocket_title
  body message air_pocket_body
end journal
journal journal.castle-drain title message exit_title
  body message exit_body
end journal
journal journal.tideglass-nave title message arrival_title
  body message arrival_body
end journal
objective objective.descend active title message objective_descend_title
  body message objective_descend_body
end objective
objective objective.open-lock hidden title message objective_lock_title
  body message objective_lock_body
end objective
objective objective.reach-castle hidden title message objective_exit_title
  body message objective_exit_body
end objective
variable quest.air-pocket-found quest flag false
variable quest.tide-lock-open quest flag false
rule rule.air-pocket-found priority 80 once
  when enter-zone zone.air-pocket
  if (flag quest.air-pocket-found false)
  do set-flag quest.air-pocket-found true
  do dialogue dialogue.air-pocket
  do journal journal.air-pocket
end rule
rule rule.castle-drain-reached priority 100 once
  when enter-zone zone.castle-drain
  if (objective objective.reach-castle active)
  do dialogue dialogue.castle-drain
  do journal journal.castle-drain
  do objective objective.reach-castle complete
  do campaign-exit flooded-ruins-castle-drain
end rule
rule rule.nave-arrival priority 100 once
  when enter-zone zone.nave-arrival
  if (objective objective.descend active)
  do dialogue dialogue.arrival
  do journal journal.tideglass-nave
  do objective objective.descend complete
  do objective objective.open-lock active
end rule
rule rule.tide-lock-opens-sluice priority 100 once
  when interact ruins.tide-lock
  if (all (objective objective.open-lock active) (flag quest.tide-lock-open false))
  do set-flag quest.tide-lock-open true
  do set-object-state ruins.tide-lock caxecraft:entered
  do set-object-state ruins.castle-sluice caxecraft:open
  do dialogue dialogue.tide-lock
  do objective objective.open-lock complete
  do objective objective.reach-castle active
end rule
rule rule.tide-lock-reminds-route priority 70 repeat
  when interact ruins.tide-lock
  if (objective objective.open-lock hidden)
  do dialogue dialogue.arrival
end rule
rule rule.tideweave-station-equipped priority 90 once
  when collect-item caxecraft:tideweave-suit
  if (objective objective.descend active)
  do dialogue dialogue.tideweave-station
end rule
end-map
