CAXEMAP 1
feature required caxecraft:core
map adventure.flooded-ruins
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "CROSS THE FLOODED RUINS"
  message adventure_tagline "PUT ON TIDEWEAVE. FIND AIR. OPEN THE CASTLE WATER GATE."
  message air_pocket_body "CEESH MARKED THIS HIGH CAVE. BREATHE HERE. THEN CROSS THE MAIN HALL."
  message air_pocket_title "CEESH'S SAFE AIR"
  message arrival_body "THE NORTH PATH HAS SAFE AIR. THE SOUTH PATH IS FASTER, BUT AN ENEMY GUARDS IT."
  message arrival_title "THE FLOODED MAIN HALL"
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "ATTACK COMING: DODGE"
  message enemy_windup "EMBER WISP GETS READY: DODGE"
  message exit_body "A DRY CASTLE TUNNEL IS AHEAD. IT LEADS BACK TO THE OLD ROAD."
  message exit_title "DRY CASTLE TUNNEL"
  message fallskeeper_ruins "TIDEWEAVE GIVES YOU MORE TIME. FIND AIR, OR MOVE FAST."
  message guide_talk "E  TALK"
  message object_use "E  USE"
  message objective_descend_body "SWIM INTO THE MAIN HALL. TIDEWEAVE GIVES YOU MORE AIR. THE HIGH NORTH CAVE IS SAFE."
  message objective_descend_title "ENTER THE FLOODED HALL"
  message objective_exit_body "PASS THE OPEN WATER GATE. CLIMB THROUGH THE DRY CASTLE TUNNEL."
  message objective_exit_title "REACH THE DRY CASTLE TUNNEL"
  message objective_lock_body "TAKE THE SAFE NORTH PATH OR THE FASTER SOUTH PATH. USE THE GLOWING TIDE SWITCH."
  message objective_lock_title "OPEN THE TIDE GATE"
  message scenario_title "Caxecraft: Flooded Ruins"
  message speaker_fallskeeper_name "Fallskeeper"
  message tide_lock_body "TIDEWEAVE STARTS THE SWITCH. THE CASTLE WATER GATE OPENS."
  message tideweave_station "TAKE TIDEWEAVE. YOU WILL NEED IT UNDERWATER."
end locale
locale es-mx
  message adventure_progress "CRUZA LAS RUINAS INUNDADAS"
  message adventure_tagline "USA TIDEWEAVE. BUSCA AIRE. ABRE LA PUERTA DEL AGUA DEL CASTILLO."
  message air_pocket_body "CEESH MARCÓ ESTA CUEVA ALTA. RESPIRA AQUÍ. DESPUÉS CRUZA LA SALA PRINCIPAL."
  message air_pocket_title "AIRE SEGURO DE CEESH"
  message arrival_body "EL CAMINO NORTE TIENE AIRE. EL CAMINO SUR ES MÁS RÁPIDO, PERO UN ENEMIGO LO CUIDA."
  message arrival_title "LA SALA PRINCIPAL INUNDADA"
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTÓ UNA LINTERNA"
  message enemy_hit_warning "VIENE UN ATAQUE: ESQUIVA"
  message enemy_windup "EL FUEGO FATUO SE PREPARA: ESQUIVA"
  message exit_body "HAY UN TÚNEL SECO ADELANTE. LLEVA DE VUELTA AL CAMINO VIEJO."
  message exit_title "TÚNEL SECO DEL CASTILLO"
  message fallskeeper_ruins "TIDEWEAVE TE DA MÁS TIEMPO. BUSCA AIRE O AVANZA RÁPIDO."
  message guide_talk "E  HABLAR"
  message object_use "E  USAR"
  message objective_descend_body "NADA HACIA LA SALA PRINCIPAL. TIDEWEAVE TE DA MÁS AIRE. LA CUEVA ALTA DEL NORTE ES SEGURA."
  message objective_descend_title "ENTRA A LA SALA INUNDADA"
  message objective_exit_body "PASA POR LA PUERTA DEL AGUA. SUBE POR EL TÚNEL SECO DEL CASTILLO."
  message objective_exit_title "LLEGA AL TÚNEL SECO DEL CASTILLO"
  message objective_lock_body "TOMA EL CAMINO NORTE SEGURO O EL CAMINO SUR RÁPIDO. USA EL INTERRUPTOR BRILLANTE."
  message objective_lock_title "ABRE LA PUERTA DE MAREA"
  message scenario_title "Caxecraft: Ruinas Inundadas"
  message speaker_fallskeeper_name "Guardián de las Cataratas"
  message tide_lock_body "TIDEWEAVE ACTIVA EL INTERRUPTOR. LA PUERTA DEL AGUA SE ABRE."
  message tideweave_station "TOMA TIDEWEAVE. LO NECESITARÁS BAJO EL AGUA."
end locale
title message scenario_title
mode adventure
world 64 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 6 caxecraft:sand
palette 8 caxecraft:ash
palette 9 caxecraft:stone
