fluid water.falls-pool caxecraft:water volume 5 3 19 10 2 5
fluid water.flooded-grotto caxecraft:water volume 11 3 24 3 2 4
fluid water.waterfall-source caxecraft:water source 8 10 17
object enemy.mossling
  tag enemy
  placement entity caxecraft:mossling 19500 7000 21500 225
end object
object guide.nia
  tag friend
  placement npc caxecraft:nia dialogue.nia.welcome 17500 8000 25500 180
end object
object item.grotto-lantern
  tag reward
  placement item caxecraft:lantern 1 12500 4000 26500 0
end object
object item.tideweave
  tag quest
  placement item caxecraft:tideweave-suit 1 4500 6000 19500 90
end object
object player.start
  tag player
  placement player-spawn 16500 8000 27500 180
end object
dialogue dialogue.nia.welcome
  line speaker guide.nia message nia_welcome
end dialogue
objective objective.western-falls active title message adventure_progress
  body message adventure_tagline
end objective
end-map
