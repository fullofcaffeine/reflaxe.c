CAXEMAP 1
feature required caxecraft:core
map adventure.western-falls
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "FIND TIDEWEAVE BENEATH THE FALLS"
  message adventure_tagline "CHOOSE THE ROOT BRIDGE OR STREAMBANK. BOTH LEAD TO THE FALLSKEEPER."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "BERRIES FULL: USE ONE FIRST"
  message block_stack_full "BLOCK STACK FULL: USE ONE FIRST"
  message enemy_alert "MOSSLING ALERT"
  message enemy_dropped_items "MOSSLING DROPPED BERRIES"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "MOSSLING WINDUP: DODGE"
  message fallskeeper_welcome "FALLSKEEPER: THE FOUR MARKS ARE RIVER, ROOT, MOON, FLAME. READ THEM IN THAT ORDER."
  message flooded_route_body "THE TIDE RELAY OPENS THE SUBMERGED RUINS. THE WEST ROAD REMAINS OPEN TOWARD FROSTMERE."
  message flooded_route_title "TWO WAYS TO THE CASTLE"
  message guide_talk "E  TALK"
  message guide_welcome "MOSS: THE FALLSKEEPER LEFT FOUR MARKS BY THE SEALED WAY"
  message journal_fallskeeper_body "VAULT CODE: RIVER, ROOT, MOON, FLAME. THE FALLSKEEPER SAYS TO READ THE MARKS IN THAT ORDER."
  message journal_fallskeeper_title "THE FALLSKEEPER'S FOUR MARKS"
  message object_use "E  USE"
  message objective_fallskeeper_body "MOSS KNOWS THE PATH. THE FALLSKEEPER WAITS WEST OF THE SHRINE."
  message objective_fallskeeper_title "ASK THE FALLSKEEPER FOR THE FOUR MARKS"
  message objective_grotto_body "TIDEWEAVE MAKES THE FLOODED PASSAGE SAFE. RECOVER ITS LANTERN."
  message objective_grotto_title "CROSS THE FLOODED GROTTO"
  message overlook_arrival "CEESH MARKED THIS ROOTWAY BEFORE BROWSER TOOK THE ARCHIVE. RIDGE ABOVE; SUPPLIES BY THE STREAM."
  message pickup_many "+2 BERRIES"
  message pickup_one "+1 BERRY"
  message player_fallen "HAXIRIO HAS FALLEN"
  message recovery_empty "NO BERRIES LEFT"
  message recovery_used "BERRIES: +1 HEART"
  message scenario_title "Caxecraft: Evergrove to Western Falls"
  message speaker_fallskeeper_name "Fallskeeper"
  message speaker_moss_name "Moss"
  message survey_note_body "CEESH MAPPED TWO SAFE DESCENTS: THE ROOT BRIDGE AND THE LOWER STREAMBANK. THEY REJOIN AT THE FALLSKEEPER'S SHRINE."
  message survey_note_found "CEESH'S SURVEY: THE ROOT BRIDGE AND STREAMBANK REJOIN BY THE FALLSKEEPER."
  message survey_note_title "CEESH'S RIVER SURVEY"
  message tide_gate_ready "THE TIDE RELAY ANSWERS THE SUIT. THE FLOODED RUINS OPEN BELOW."
  message vault_open "THE FOUR MARKS ANSWER. THE SEALED WAY OPENS."
  message vault_reset "THE MARKS FALL SILENT. BEGIN AGAIN WITH RIVER."
end locale
locale es-mx
  message adventure_progress "BUSCA TIDEWEAVE BAJO LAS CATARATAS"
  message adventure_tagline "ELIGE EL PUENTE DE RAICES O LA ORILLA. AMBOS LLEVAN AL GUARDIAN."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "BAYAS LLENAS: USA UNA PRIMERO"
  message block_stack_full "PILA DE BLOQUES LLENA: USA UNO"
  message enemy_alert "MUSGUITO ALERTA"
  message enemy_dropped_items "EL MUSGUITO SOLTO BAYAS"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "MUSGUITO CARGANDO: ESQUIVA"
  message fallskeeper_welcome "GUARDIAN: LAS CUATRO MARCAS SON RIO, RAIZ, LUNA, LLAMA. LEELAS EN ESE ORDEN."
  message flooded_route_body "EL RELE DE MAREA ABRE LAS RUINAS SUMERGIDAS. EL CAMINO OESTE SIGUE ABIERTO HACIA FROSTMERE."
  message flooded_route_title "DOS CAMINOS AL CASTILLO"
  message guide_talk "E  HABLAR"
  message guide_welcome "MOSS: EL GUARDIAN DE LAS CATARATAS DEJO CUATRO MARCAS"
  message journal_fallskeeper_body "CLAVE DE LA BOVEDA: RIO, RAIZ, LUNA, LLAMA. EL GUARDIAN DICE QUE LAS LEAS EN ESE ORDEN."
  message journal_fallskeeper_title "LAS CUATRO MARCAS DEL GUARDIAN"
  message object_use "E  USAR"
  message objective_fallskeeper_body "MOSS CONOCE EL CAMINO. EL GUARDIAN ESPERA AL OESTE DEL SANTUARIO."
  message objective_fallskeeper_title "PIDE AL GUARDIAN LAS CUATRO MARCAS"
  message objective_grotto_body "TIDEWEAVE HACE SEGURO EL PASO INUNDADO. RECUPERA SU LINTERNA."
  message objective_grotto_title "CRUZA LA GRUTA INUNDADA"
  message overlook_arrival "CEESH MARCO ESTE SENDERO DE RAICES ANTES DE QUE BROWSER TOMARA EL ARCHIVO. CRESTA ARRIBA; VIVERES JUNTO AL RIO."
  message pickup_many "+2 BAYAS"
  message pickup_one "+1 BAYA"
  message player_fallen "HAXIRIO HA CAIDO"
  message recovery_empty "NO QUEDAN BAYAS"
  message recovery_used "BAYAS: +1 CORAZON"
  message scenario_title "Caxecraft: Evergrove a Cataratas del Oeste"
  message speaker_fallskeeper_name "Guardian de las Cataratas"
  message speaker_moss_name "Moss"
  message survey_note_body "CEESH TRAZO DOS DESCENSOS SEGUROS: EL PUENTE DE RAICES Y LA ORILLA BAJA. SE UNEN EN EL SANTUARIO DEL GUARDIAN."
  message survey_note_found "MAPA DE CEESH: EL PUENTE DE RAICES Y LA ORILLA SE UNEN JUNTO AL GUARDIAN."
  message survey_note_title "MAPA DEL RIO DE CEESH"
  message tide_gate_ready "EL RELE RESPONDE AL TRAJE. LAS RUINAS INUNDADAS SE ABREN ABAJO."
  message vault_open "LAS CUATRO MARCAS RESPONDEN. EL PASO SELLADO SE ABRE."
  message vault_reset "LAS MARCAS CALLAN. EMPIEZA DE NUEVO CON RIO."
end locale
title message scenario_title
mode adventure
world 64 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
