fluid water.evergrove-stream-north caxecraft:water volume 36 3 0 3 2 21
fluid water.evergrove-stream-source caxecraft:water source 36 4 4
fluid water.evergrove-stream-south caxecraft:water volume 36 3 23 3 2 9
fluid water.evergrove-stream-under-bridge caxecraft:water volume 36 3 21 3 1 2
fluid water.evergrove-well caxecraft:water volume 44 5 22 1 1 1
fluid water.falls-pool caxecraft:water volume 5 3 19 10 2 5
fluid water.flooded-grotto caxecraft:water volume 11 3 24 3 2 4
fluid water.flooded-grotto-source caxecraft:water source 12 5 25
fluid water.waterfall-source caxecraft:water source 8 10 17
object enemy.mossling
  tag enemy
  placement entity caxecraft:mossling 50500 5000 25500 180
end object
object guide.fallskeeper
  tag friend
  placement npc caxecraft:fallskeeper dialogue.fallskeeper.marks 13500 8000 25500 180
end object
object guide.moss
  tag friend
  placement npc caxecraft:moss dialogue.moss.falls 17500 8000 25500 180
end object
object item.grotto-lantern
  tag reward
  placement item caxecraft:lantern 1 12500 4000 26500 0
end object
object item.rootway-ration
  tag discovery
  tag reward
  placement item caxecraft:bread 2 26500 5000 25500 0
end object
object item.survey-berries
  tag discovery
  tag reward
  placement item caxecraft:berries 2 46500 5000 27500 0
end object
object item.tideweave
  tag quest
  placement item caxecraft:tideweave-suit 1 4500 4000 19500 90
end object
object landmark.ceesh-survey
  tag discovery
  tag lore
  placement stateful caxecraft:ceesh-field-note caxecraft:waiting 45500 5000 27500 0
end object
object player.start
  tag player
  placement player-spawn 35500 5000 18500 270
end object
object route.flooded-ruins-relay
  tag destination
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 14500 3000 26500 180
end object
object vault.gate
  tag vault-gate
  placement stateful caxecraft:vault-gate caxecraft:sealed 5000 3000 20000 0
end object
object vault.glyph-flame
  tag vault-control
  placement stateful caxecraft:vault-glyph-flame caxecraft:waiting 12000 3000 21500 0
end object
object vault.glyph-leaf
  tag vault-control
  placement stateful caxecraft:vault-glyph-leaf caxecraft:waiting 9000 3000 21500 0
end object
object vault.glyph-moon
  tag vault-control
  placement stateful caxecraft:vault-glyph-moon caxecraft:waiting 10500 3000 21500 0
end object
object vault.glyph-river
  tag vault-control
  placement stateful caxecraft:vault-glyph-river caxecraft:waiting 7500 3000 21500 0
end object
object zone.frostmere-road
  tag destination
  placement trigger-zone 5 0 19 5 16 8
end object
object zone.western-overlook
  tag landmark
  placement trigger-zone 24 0 16 7 16 16
end object
speaker guide.fallskeeper name message speaker_fallskeeper_name
speaker guide.moss name message speaker_moss_name
dialogue dialogue.fallskeeper.marks
  line speaker guide.fallskeeper message fallskeeper_welcome
end dialogue
dialogue dialogue.flooded-route
  line narrator message tide_gate_ready
end dialogue
dialogue dialogue.moss.falls
  line speaker guide.moss message guide_welcome
end dialogue
dialogue dialogue.overlook.arrival
  line narrator message overlook_arrival
end dialogue
dialogue dialogue.survey.note
  line narrator message survey_note_found
end dialogue
dialogue dialogue.vault.open
  line speaker guide.fallskeeper message vault_open
end dialogue
dialogue dialogue.vault.reset
  line speaker guide.fallskeeper message vault_reset
end dialogue
journal journal.ceesh-river-survey title message survey_note_title
  body message survey_note_body
end journal
journal journal.fallskeeper-lead title message journal_fallskeeper_title
  body message journal_fallskeeper_body
end journal
journal journal.flooded-route title message flooded_route_title
  body message flooded_route_body
end journal
objective objective.explore-grotto hidden title message objective_grotto_title
  body message objective_grotto_body
end objective
objective objective.find-fallskeeper active title message objective_fallskeeper_title
  body message objective_fallskeeper_body
end objective
objective objective.find-tideweave hidden title message adventure_progress
  body message adventure_tagline
end objective
variable quest.vault-progress quest counter 0
rule rule.fallskeeper-reveals-the-marks priority 110 once
  when interact guide.fallskeeper
  if (objective objective.find-fallskeeper active)
  do dialogue dialogue.fallskeeper.marks
  do journal journal.fallskeeper-lead
  do objective objective.find-fallskeeper complete
  do objective objective.find-tideweave active
end rule
rule rule.flame-accepts-fourth-mark priority 110 repeat
  when interact vault.glyph-flame
  if (counter quest.vault-progress equal 3)
  do set-object-state vault.glyph-flame caxecraft:entered
  do set-object-state vault.gate caxecraft:open
  do set-counter quest.vault-progress 4
  do dialogue dialogue.vault.open
end rule
rule rule.flame-resets-wrong-code priority 120 repeat
  when interact vault.glyph-flame
  if (not (counter quest.vault-progress equal 3))
  do set-counter quest.vault-progress 0
  do set-object-state vault.glyph-flame caxecraft:waiting
  do set-object-state vault.glyph-leaf caxecraft:waiting
  do set-object-state vault.glyph-moon caxecraft:waiting
  do set-object-state vault.glyph-river caxecraft:waiting
  do dialogue dialogue.vault.reset
end rule
rule rule.flooded-ruins-route-opens priority 100 once
  when interact route.flooded-ruins-relay
  if (objective objective.explore-grotto complete)
  do set-object-state route.flooded-ruins-relay caxecraft:entered
  do dialogue dialogue.flooded-route
  do journal journal.flooded-route
  do campaign-exit western-falls-flooded-ruins
end rule
rule rule.frostmere-road-opens priority 100 once
  when enter-zone zone.frostmere-road
  if (objective objective.explore-grotto complete)
  do campaign-exit western-falls-frostmere-road
end rule
rule rule.lantern-completes-the-grotto priority 80 once
  when collect-item caxecraft:lantern
  if (objective objective.explore-grotto active)
  do objective objective.explore-grotto complete
end rule
rule rule.leaf-accepts-second-mark priority 110 repeat
  when interact vault.glyph-leaf
  if (counter quest.vault-progress equal 1)
  do set-object-state vault.glyph-leaf caxecraft:entered
  do set-counter quest.vault-progress 2
end rule
rule rule.leaf-resets-wrong-code priority 120 repeat
  when interact vault.glyph-leaf
  if (not (counter quest.vault-progress equal 1))
  do set-counter quest.vault-progress 0
  do set-object-state vault.glyph-flame caxecraft:waiting
  do set-object-state vault.glyph-leaf caxecraft:waiting
  do set-object-state vault.glyph-moon caxecraft:waiting
  do set-object-state vault.glyph-river caxecraft:waiting
  do dialogue dialogue.vault.reset
end rule
rule rule.moon-accepts-third-mark priority 110 repeat
  when interact vault.glyph-moon
  if (counter quest.vault-progress equal 2)
  do set-object-state vault.glyph-moon caxecraft:entered
  do set-counter quest.vault-progress 3
end rule
rule rule.moon-resets-wrong-code priority 120 repeat
  when interact vault.glyph-moon
  if (not (counter quest.vault-progress equal 2))
  do set-counter quest.vault-progress 0
  do set-object-state vault.glyph-flame caxecraft:waiting
  do set-object-state vault.glyph-leaf caxecraft:waiting
  do set-object-state vault.glyph-moon caxecraft:waiting
  do set-object-state vault.glyph-river caxecraft:waiting
  do dialogue dialogue.vault.reset
end rule
rule rule.moss-opens-the-western-route priority 100 once
  when interact guide.moss
  if (always)
  do dialogue dialogue.moss.falls
end rule
rule rule.overlook-establishes-the-falls priority 90 once
  when enter-zone zone.western-overlook
  if (objective objective.find-fallskeeper active)
  do dialogue dialogue.overlook.arrival
end rule
rule rule.river-accepts-first-mark priority 110 repeat
  when interact vault.glyph-river
  if (counter quest.vault-progress equal 0)
  do set-object-state vault.glyph-river caxecraft:entered
  do set-counter quest.vault-progress 1
end rule
rule rule.river-resets-and-starts-code priority 120 repeat
  when interact vault.glyph-river
  if (not (counter quest.vault-progress equal 0))
  do set-counter quest.vault-progress 0
  do set-object-state vault.glyph-flame caxecraft:waiting
  do set-object-state vault.glyph-leaf caxecraft:waiting
  do set-object-state vault.glyph-moon caxecraft:waiting
  do set-object-state vault.glyph-river caxecraft:waiting
  do dialogue dialogue.vault.reset
end rule
rule rule.survey-note-rewards-exploration priority 100 once
  when interact landmark.ceesh-survey
  if (object-state landmark.ceesh-survey caxecraft:waiting)
  do set-object-state landmark.ceesh-survey caxecraft:entered
  do dialogue dialogue.survey.note
  do journal journal.ceesh-river-survey
end rule
rule rule.tideweave-opens-the-grotto priority 90 once
  when collect-item caxecraft:tideweave-suit
  if (objective objective.find-tideweave active)
  do objective objective.find-tideweave complete
  do objective objective.explore-grotto active
end rule
end-map
