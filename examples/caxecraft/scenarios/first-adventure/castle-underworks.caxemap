CAXEMAP 1
feature required caxecraft:core
map adventure.castle-underworks
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "INFILTRATE THE CASTLE UNDERWORKS"
  message adventure_tagline "CHOOSE A SERVICE ROUTE. ISOLATE THE SABOTAGE. REACH THE ARCHIVE."
  message archive_body "THE FORGE ARCHIVE DOOR IS AHEAD. BROWSER IS BEYOND IT, BUT THIS WING IS SAFE."
  message archive_title "FORGE ARCHIVE ANTECHAMBER"
  message cache_body "CEESH STORED EMERGENCY BREAD ABOVE THE COOLANT GALLERY."
  message cache_title "ENGINEER'S CACHE"
  message ceesh_briefing "CEESH: THE LIFT IS SABOTAGED. COOLANT GALLERY OR ASH VENT. EITHER CAN ISOLATE THIS WING."
  message coolant_ready "THE COOLANT RELAY CUTS BROWSER'S FEED. THE ARCHIVE PASSAGE OPENS."
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "EMBER WISP WINDUP: DODGE"
  message guide_talk "E  TALK"
  message object_use "E  USE"
  message objective_archive_body "FOLLOW THE REJOINED SERVICE WALKWAY TO THE FORGE ARCHIVE ANTECHAMBER."
  message objective_archive_title "REACH THE FORGE ARCHIVE"
  message objective_isolate_body "TAKE THE SAFE COOLANT GALLERY OR THE FASTER ASH VENT. ACTIVATE ONE CONTROL."
  message objective_isolate_title "ISOLATE BROWSER'S SABOTAGE"
  message scenario_title "Caxecraft: Castle Underworks"
  message vent_ready "THE ASH VENT SLAMS SHUT. BROWSER LOSES HIS FEED, AND THE ARCHIVE PASSAGE OPENS."
end locale
locale es-mx
  message adventure_progress "INFILTRATE LOS TUNELES DEL CASTILLO"
  message adventure_tagline "ELIGE UNA RUTA. AISLA EL SABOTAJE. LLEGA AL ARCHIVO."
  message archive_body "LA PUERTA DEL ARCHIVO DE LA FORJA ESTA ADELANTE. BROWSER ESTA DETRAS, PERO ESTA ALA YA ES SEGURA."
  message archive_title "ANTESALA DEL ARCHIVO DE LA FORJA"
  message cache_body "CEESH GUARDO PAN DE EMERGENCIA SOBRE LA GALERIA DE REFRIGERACION."
  message cache_title "RESERVA DE LA INGENIERA"
  message ceesh_briefing "CEESH: EL ELEVADOR ESTA SABOTEADO. LA GALERIA O EL RESPIRADERO PUEDEN AISLAR ESTA ALA."
  message coolant_ready "EL RELE DE REFRIGERACION CORTA LA CONEXION DE BROWSER. EL PASO AL ARCHIVO SE ABRE."
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTO UNA LINTERNA"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "FUEGO FATUO CARGANDO: ESQUIVA"
  message guide_talk "E  HABLAR"
  message object_use "E  USAR"
  message objective_archive_body "SIGUE LA PASARELA DE SERVICIO HASTA LA ANTESALA DEL ARCHIVO."
  message objective_archive_title "LLEGA AL ARCHIVO DE LA FORJA"
  message objective_isolate_body "USA LA GALERIA SEGURA O EL RESPIRADERO RAPIDO. ACTIVA UN CONTROL."
  message objective_isolate_title "AISLA EL SABOTAJE DE BROWSER"
  message scenario_title "Caxecraft: Tuneles del Castillo"
  message vent_ready "EL RESPIRADERO SE CIERRA. BROWSER PIERDE SU CONEXION Y EL PASO AL ARCHIVO SE ABRE."
end locale
title message scenario_title
mode adventure
world 64 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
