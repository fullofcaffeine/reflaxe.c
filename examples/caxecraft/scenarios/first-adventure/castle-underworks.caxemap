fluid underworks.coolant-channel caxecraft:water volume 20 5 3 21 1 1
object guide.ceesh
  tag friend
  placement npc caxecraft:ceesh dialogue.ceesh.briefing 11500 5000 16500 270
end object
object item.engineer-cache
  tag secret
  placement item caxecraft:bread 3 45500 5000 6500 0
end object
object player.start
  tag player
  placement player-spawn 5500 5000 16500 90
end object
object underworks.archive-gate
  tag mechanism
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 52500 5000 16500 90
end object
object underworks.coolant-relay
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 31500 5000 7500 180
end object
object underworks.ember-wisp
  tag enemy
  placement entity caxecraft:ember-wisp 38500 5000 25500 180
end object
object underworks.vent-winch
  tag mechanism
  placement stateful caxecraft:gate-winch caxecraft:waiting 31500 5000 25500 0
end object
object zone.archive-antechamber
  tag destination
  placement trigger-zone 55 4 10 7 8 13
end object
dialogue dialogue.archive-reached
  line speaker guide.ceesh message archive_body
end dialogue
dialogue dialogue.cache-found
  line speaker guide.ceesh message cache_body
end dialogue
dialogue dialogue.ceesh.briefing
  line speaker guide.ceesh message ceesh_briefing
end dialogue
dialogue dialogue.coolant-ready
  line speaker guide.ceesh message coolant_ready
end dialogue
dialogue dialogue.vent-ready
  line speaker guide.ceesh message vent_ready
end dialogue
journal journal.archive-antechamber title message archive_title
  body message archive_body
end journal
journal journal.engineer-cache title message cache_title
  body message cache_body
end journal
objective objective.isolate-wing active title message objective_isolate_title
  body message objective_isolate_body
end objective
objective objective.reach-archive hidden title message objective_archive_title
  body message objective_archive_body
end objective
variable quest.engineer-cache-found quest flag false
variable quest.underworks-isolated quest flag false
rule rule.archive-antechamber-reached priority 100 once
  when enter-zone zone.archive-antechamber
  if (objective objective.reach-archive active)
  do dialogue dialogue.archive-reached
  do journal journal.archive-antechamber
  do objective objective.reach-archive complete
end rule
rule rule.ceesh-briefing priority 90 repeat
  when interact guide.ceesh
  if (objective objective.isolate-wing active)
  do dialogue dialogue.ceesh.briefing
end rule
rule rule.coolant-gallery-isolates-wing priority 100 once
  when interact underworks.coolant-relay
  if (flag quest.underworks-isolated false)
  do set-flag quest.underworks-isolated true
  do set-object-state underworks.coolant-relay caxecraft:entered
  do set-object-state underworks.archive-gate caxecraft:open
  do dialogue dialogue.coolant-ready
  do objective objective.isolate-wing complete
  do objective objective.reach-archive active
end rule
rule rule.engineer-cache-found priority 100 once
  when collect-item caxecraft:bread
  if (flag quest.engineer-cache-found false)
  do set-flag quest.engineer-cache-found true
  do dialogue dialogue.cache-found
  do journal journal.engineer-cache
end rule
rule rule.vent-isolates-wing priority 100 once
  when interact underworks.vent-winch
  if (flag quest.underworks-isolated false)
  do set-flag quest.underworks-isolated true
  do set-object-state underworks.vent-winch caxecraft:entered
  do set-object-state underworks.archive-gate caxecraft:open
  do dialogue dialogue.vent-ready
  do objective objective.isolate-wing complete
  do objective objective.reach-archive active
end rule
end-map
