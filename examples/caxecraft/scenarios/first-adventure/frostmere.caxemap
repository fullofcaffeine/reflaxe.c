CAXEMAP 1
feature required caxecraft:core
map adventure.frostmere
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "REACH THE ASHFALL BEACON"
  message adventure_tagline "FIND NIA. OPEN THE RAVINE. TUNE THE ASHFALL SIGNALS."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "BERRIES FULL: USE ONE FIRST"
  message block_stack_full "BLOCK STACK FULL: USE ONE FIRST"
  message enemy_alert "SNOWBOUND MOSSLING ALERT"
  message enemy_dropped_items "MOSSLING DROPPED BERRIES"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "MOSSLING WINDUP: DODGE"
  message guide_talk "E  TALK"
  message journal_ashfall_body "THE RECOVERED LANTERN BURNS GOLD AGAINST THE ASH. TWO STONE CAIRNS MARK THE ROAD INTO THE FALL."
  message journal_ashfall_title "THE ASHFALL THRESHOLD"
  message journal_frostmere_body "NIA'S SIGNAL ORDER: MELTWATER, HAXEFORGE, EMBER. FOLLOW WAVE, FORGE, FLAME BEYOND THE TIMBER BRIDGE."
  message journal_frostmere_title "THE FROSTMERE ASCENT"
  message journal_western_road_body "A ROOT ARCH MARKS THE LAST GREEN STONE. THE SNOW ROAD BENDS WEST TO NIA; A CAIRN OVERLOOKS THE FALLS."
  message journal_western_road_title "CEESH'S FROSTMERE ROAD"
  message nia_welcome "NIA: FOLLOW THE ROAD WEST. CEESH'S BLUE WINCH LOWERS THE RAVINE BRIDGE."
  message object_use "E  USE"
  message objective_arrival_body "PASS UNDER THE ROOT ARCH. NIA WAITS WHERE GREEN STONE GIVES WAY TO SNOW."
  message objective_arrival_title "FOLLOW THE WESTERN ROAD TO NIA"
  message objective_lantern_body "THE SIGNAL GATE IS OPEN. CLIMB TO THE GOLD LANTERN AND ASHFALL BEACON."
  message objective_lantern_title "RECOVER THE ASHFALL LANTERN"
  message objective_overlook_body "BEYOND THE TIMBER BRIDGE, WAKE WAVE, FORGE, THEN FLAME. WRONG NOTES RESET SAFELY."
  message objective_overlook_title "TUNE THE THREE ASHFALL SIGNALS"
  message objective_seek_ashfall_body "THE SNOW ENDS UNDER A DARKENING SKY. THE ASHFALL BRIDGE LIES AHEAD."
  message objective_seek_ashfall_title "ASHFALL LIES BEYOND FROSTMERE"
  message objective_winch_body "FOLLOW THE RISING SNOW PATH TO CEESH'S BLUE WINCH IN THE RAVINE SHRINE."
  message objective_winch_title "LOWER THE RAVINE BRIDGE"
  message pickup_many "+2 BERRIES"
  message pickup_one "+1 BERRY"
  message player_fallen "HAXIRIO HAS FALLEN"
  message ravine_winch_opened "CEESH'S WINCH TURNS. TIMBERS SETTLE ACROSS THE RAVINE."
  message recovery_empty "NO BERRIES LEFT"
  message recovery_used "BERRIES: +1 HEART"
  message road_marker_found "CEESH'S ROAD MARKER: WATER BELOW, FROST ABOVE. NIA KEEPS THE SAFE ASCENT."
  message scenario_title "Caxecraft: Frostmere"
  message signals_reset "THE SIGNALS FALL QUIET. BEGIN AGAIN: WAVE, FORGE, FLAME."
  message signals_solved "THE THREE SIGNALS HARMONIZE. THE ASHFALL GATE OPENS."
end locale
locale es-mx
  message adventure_progress "LLEGA AL FARO DE ASHFALL"
  message adventure_tagline "ENCUENTRA A NIA. ABRE EL BARRANCO. AFINA LAS SENALES."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "BAYAS LLENAS: USA UNA PRIMERO"
  message block_stack_full "PILA DE BLOQUES LLENA: USA UNO"
  message enemy_alert "MUSGUITO DE NIEVE ALERTA"
  message enemy_dropped_items "EL MUSGUITO SOLTO BAYAS"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "MUSGUITO CARGANDO: ESQUIVA"
  message guide_talk "E  HABLAR"
  message journal_ashfall_body "LA LINTERNA RECUPERADA ARDE DORADA CONTRA LA CENIZA. DOS MOJONES DE PIEDRA MARCAN EL CAMINO."
  message journal_ashfall_title "EL UMBRAL DE ASHFALL"
  message journal_frostmere_body "ORDEN DE NIA: DESHIELO, HAXEFORGE, BRASA. SIGUE OLA, FORJA, LLAMA TRAS EL PUENTE."
  message journal_frostmere_title "EL ASCENSO DE FROSTMERE"
  message journal_western_road_body "UN ARCO DE RAICES MARCA LA ULTIMA PIEDRA VERDE. EL CAMINO GIRA AL OESTE HACIA NIA; UN MOJON MIRA A LAS CATARATAS."
  message journal_western_road_title "EL CAMINO DE CEESH A FROSTMERE"
  message nia_welcome "NIA: SIGUE EL CAMINO AL OESTE. EL TORNO AZUL DE CEESH BAJA EL PUENTE."
  message object_use "E  USAR"
  message objective_arrival_body "PASA BAJO EL ARCO DE RAICES. NIA ESPERA DONDE LA PIEDRA VERDE SE VUELVE NIEVE."
  message objective_arrival_title "SIGUE EL CAMINO DEL OESTE HASTA NIA"
  message objective_lantern_body "LA PUERTA ESTA ABIERTA. SUBE A LA LINTERNA DORADA Y AL FARO DE ASHFALL."
  message objective_lantern_title "RECUPERA LA LINTERNA DE ASHFALL"
  message objective_overlook_body "TRAS EL PUENTE, ENCIENDE OLA, FORJA Y LLAMA. UN ERROR REINICIA SIN PELIGRO."
  message objective_overlook_title "AFINA LAS TRES SENALES DE ASHFALL"
  message objective_seek_ashfall_body "LA NIEVE TERMINA BAJO UN CIELO OSCURO. EL PUENTE DE ASHFALL ESTA ADELANTE."
  message objective_seek_ashfall_title "ASHFALL ESTA MAS ALLA DE FROSTMERE"
  message objective_winch_body "SIGUE EL SENDERO DE NIEVE HASTA EL TORNO AZUL DE CEESH EN EL SANTUARIO DEL BARRANCO."
  message objective_winch_title "BAJA EL PUENTE DEL BARRANCO"
  message pickup_many "+2 BAYAS"
  message pickup_one "+1 BAYA"
  message player_fallen "HAXIRIO HA CAIDO"
  message ravine_winch_opened "EL TORNO DE CEESH GIRA. LAS VIGAS CUBREN EL BARRANCO."
  message recovery_empty "NO QUEDAN BAYAS"
  message recovery_used "BAYAS: +1 CORAZON"
  message road_marker_found "MARCA DE CEESH: AGUA ABAJO, HIELO ARRIBA. NIA GUARDA EL ASCENSO SEGURO."
  message scenario_title "Caxecraft: Frostmere"
  message signals_reset "LAS SENALES CALLAN. EMPIEZA DE NUEVO: OLA, FORJA, LLAMA."
  message signals_solved "LAS TRES SENALES ARMONIZAN. LA PUERTA DE ASHFALL SE ABRE."
end locale
title message scenario_title
mode adventure
