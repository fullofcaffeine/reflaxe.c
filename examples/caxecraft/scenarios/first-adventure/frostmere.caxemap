fluid snow.ravine-meltwater caxecraft:water volume 5 3 14 22 2 3
object ashfall.beacon
  tag landmark
  placement stateful caxecraft:vault-glyph-flame caxecraft:waiting 16500 12000 500 180
end object
object enemy.snow-mossling
  tag enemy
  placement entity caxecraft:mossling 18500 7000 12500 180
end object
object guide.nia
  tag friend
  placement npc caxecraft:nia dialogue.nia.frostmere 16500 4000 25500 180
end object
object item.ashfall-lantern
  tag reward
  placement item caxecraft:lantern 1 16500 9000 5500 0
end object
object player.start
  tag player
  placement player-spawn 16500 4000 28500 180
end object
object signal.flame
  tag mechanism
  placement stateful caxecraft:vault-glyph-flame caxecraft:waiting 16500 8000 9500 0
end object
object signal.forge
  tag mechanism
  placement stateful caxecraft:vault-glyph-moon caxecraft:waiting 16500 8000 11500 0
end object
object signal.gate
  tag mechanism
  placement stateful caxecraft:vault-gate caxecraft:sealed 16500 8000 8500 0
end object
object signal.wave
  tag mechanism
  placement stateful caxecraft:vault-glyph-river caxecraft:waiting 16500 7000 13500 0
end object
object snow.ember
  tag mechanism
  placement stateful caxecraft:vault-glyph-flame caxecraft:waiting 16500 6000 18500 0
end object
object snow.gate
  tag mechanism
  placement stateful caxecraft:vault-gate caxecraft:sealed 16500 6000 15500 0
end object
dialogue dialogue.nia.frostmere
  line speaker guide.nia message nia_welcome
end dialogue
dialogue dialogue.signals.reset
  line speaker guide.nia message signals_reset
end dialogue
dialogue dialogue.signals.solved
  line speaker guide.nia message signals_solved
end dialogue
dialogue dialogue.snow.ember
  line speaker guide.nia message ember_awake
end dialogue
journal journal.ashfall-threshold title message journal_ashfall_title
  body message journal_ashfall_body
end journal
journal journal.frostmere-route title message journal_frostmere_title
  body message journal_frostmere_body
end journal
objective objective.ask-nia active title message objective_arrival_title
  body message objective_arrival_body
end objective
objective objective.reach-overlook hidden title message objective_overlook_title
  body message objective_overlook_body
end objective
objective objective.recover-lantern hidden title message objective_lantern_title
  body message objective_lantern_body
end objective
objective objective.seek-ashfall hidden title message objective_seek_ashfall_title
  body message objective_seek_ashfall_body
end objective
objective objective.wake-ember hidden title message objective_ember_title
  body message objective_ember_body
end objective
variable quest.signal-progress quest counter 0
rule rule.ember-opens-the-bridge priority 100 once
  when interact snow.ember
  if (objective objective.wake-ember active)
  do set-object-state snow.ember caxecraft:entered
  do set-object-state snow.gate caxecraft:open
  do dialogue dialogue.snow.ember
  do objective objective.wake-ember complete
  do objective objective.reach-overlook active
end rule
rule rule.lantern-reveals-ashfall priority 100 once
  when collect-item caxecraft:lantern
  if (objective objective.recover-lantern active)
  do journal journal.ashfall-threshold
  do objective objective.recover-lantern complete
  do objective objective.seek-ashfall active
end rule
rule rule.nia-marks-the-ascent priority 100 once
  when interact guide.nia
  if (objective objective.ask-nia active)
  do dialogue dialogue.nia.frostmere
  do journal journal.frostmere-route
  do objective objective.ask-nia complete
  do objective objective.wake-ember active
end rule
rule rule.signal-flame-completes-the-tune priority 100 once
  when interact signal.flame
  if (counter quest.signal-progress equal 2)
  do set-object-state signal.flame caxecraft:entered
  do set-object-state signal.gate caxecraft:open
  do set-counter quest.signal-progress 3
  do dialogue dialogue.signals.solved
  do objective objective.reach-overlook complete
  do objective objective.recover-lantern active
end rule
rule rule.signal-flame-resets-the-tune priority 90 repeat
  when interact signal.flame
  if (not (counter quest.signal-progress equal 2))
  do set-counter quest.signal-progress 0
  do set-object-state signal.flame caxecraft:waiting
  do set-object-state signal.forge caxecraft:waiting
  do set-object-state signal.wave caxecraft:waiting
  do dialogue dialogue.signals.reset
end rule
rule rule.signal-forge-continues-the-tune priority 100 repeat
  when interact signal.forge
  if (counter quest.signal-progress equal 1)
  do set-object-state signal.forge caxecraft:entered
  do set-counter quest.signal-progress 2
end rule
rule rule.signal-forge-resets-the-tune priority 90 repeat
  when interact signal.forge
  if (not (counter quest.signal-progress equal 1))
  do set-counter quest.signal-progress 0
  do set-object-state signal.flame caxecraft:waiting
  do set-object-state signal.forge caxecraft:waiting
  do set-object-state signal.wave caxecraft:waiting
  do dialogue dialogue.signals.reset
end rule
rule rule.signal-wave-begins-the-tune priority 100 repeat
  when interact signal.wave
  if (counter quest.signal-progress equal 0)
  do set-object-state signal.wave caxecraft:entered
  do set-counter quest.signal-progress 1
end rule
rule rule.signal-wave-resets-the-tune priority 90 repeat
  when interact signal.wave
  if (not (counter quest.signal-progress equal 0))
  do set-counter quest.signal-progress 0
  do set-object-state signal.flame caxecraft:waiting
  do set-object-state signal.forge caxecraft:waiting
  do set-object-state signal.wave caxecraft:waiting
  do dialogue dialogue.signals.reset
end rule
end-map
