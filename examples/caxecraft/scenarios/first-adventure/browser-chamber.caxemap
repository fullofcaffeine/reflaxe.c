fluid chamber.coolant caxecraft:water volume 2 5 26 3 1 2
object arena.entry-gate
  tag gate
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 15500 5000 22500 0
end object
object arena.exit-gate
  tag gate
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 15500 5000 4500 0
end object
object arena.relay-east
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 23500 5000 26500 0
end object
object arena.relay-west
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 7500 5000 26500 0
end object
object enemy.browser
  tag boss
  tag enemy
  placement entity caxecraft:browser 15500 5000 9000 180
end object
object guide.ceesh
  tag friend
  placement npc caxecraft:ceesh dialogue.ceesh-briefing 15500 5000 27500 180
end object
object player.start
  tag player
  placement player-spawn 15500 5000 29500 0
end object
object zone.victory
  tag destination
  placement trigger-zone 10 4 1 12 6 3
end object
speaker guide.ceesh name message speaker_ceesh_name
dialogue dialogue.browser-defeated
  line speaker guide.ceesh message browser_defeated
end dialogue
dialogue dialogue.ceesh-briefing
  line speaker guide.ceesh message ceesh_briefing
end dialogue
dialogue dialogue.east-ready
  line speaker guide.ceesh message east_ready
end dialogue
dialogue dialogue.victory
  line speaker guide.ceesh message victory_body
end dialogue
dialogue dialogue.west-ready
  line speaker guide.ceesh message west_ready
end dialogue
journal journal.browser-defeated title message objective_return_title
  body message browser_defeated
end journal
journal journal.victory title message victory_title
  body message victory_body
end journal
objective objective.confront-browser hidden title message objective_browser_title
  body message objective_browser_body
end objective
objective objective.join-ceesh active title message objective_ceesh_title
  body message objective_ceesh_body
end objective
objective objective.prepare-arena hidden title message objective_prepare_title
  body message objective_prepare_body
end objective
objective objective.return-to-ceesh hidden title message objective_return_title
  body message objective_return_body
end objective
variable quest.east-relay-ready quest flag false
variable quest.west-relay-ready quest flag false
rule rule.browser-defeated priority 100 once
  when entity-defeated enemy.browser
  if (objective objective.confront-browser active)
  do set-object-state arena.exit-gate caxecraft:open
  do dialogue dialogue.browser-defeated
  do journal journal.browser-defeated
  do objective objective.confront-browser complete
  do objective objective.return-to-ceesh active
end rule
rule rule.ceesh-briefing priority 100 once
  when interact guide.ceesh
  if (objective objective.join-ceesh active)
  do dialogue dialogue.ceesh-briefing
  do objective objective.join-ceesh complete
  do objective objective.prepare-arena active
end rule
rule rule.east-opens-entry priority 90 once
  when interact arena.relay-east
  if (all (objective objective.prepare-arena active) (flag quest.east-relay-ready false) (flag quest.west-relay-ready true))
  do set-object-state arena.entry-gate caxecraft:open
  do objective objective.prepare-arena complete
  do objective objective.confront-browser active
end rule
rule rule.east-relay-ready priority 100 once
  when interact arena.relay-east
  if (all (objective objective.prepare-arena active) (flag quest.east-relay-ready false))
  do set-flag quest.east-relay-ready true
  do set-object-state arena.relay-east caxecraft:entered
  do dialogue dialogue.east-ready
end rule
rule rule.victory-reached priority 100 once
  when enter-zone zone.victory
  if (objective objective.return-to-ceesh active)
  do dialogue dialogue.victory
  do journal journal.victory
  do objective objective.return-to-ceesh complete
end rule
rule rule.west-opens-entry priority 90 once
  when interact arena.relay-west
  if (all (objective objective.prepare-arena active) (flag quest.east-relay-ready true) (flag quest.west-relay-ready false))
  do set-object-state arena.entry-gate caxecraft:open
  do objective objective.prepare-arena complete
  do objective objective.confront-browser active
end rule
rule rule.west-relay-ready priority 100 once
  when interact arena.relay-west
  if (all (objective objective.prepare-arena active) (flag quest.west-relay-ready false))
  do set-flag quest.west-relay-ready true
  do set-object-state arena.relay-west caxecraft:entered
  do dialogue dialogue.west-ready
end rule
end-map
