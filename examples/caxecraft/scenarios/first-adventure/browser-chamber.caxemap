CAXEMAP 1
feature required caxecraft:core
map adventure.browser-chamber
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "BREAK BROWSER'S HOLD"
  message adventure_tagline "PREPARE WITH CEESH. READ THE ATTACK. STRIKE TOGETHER."
  message attack_hit "HAXEFORGE STRIKE"
  message browser_defeated "CEESH: THE ARCHIVE IS OURS AGAIN. YOU MADE THE OPENING; WE FINISHED IT TOGETHER."
  message ceesh_briefing "CEESH: I BUILT TWO FORGE RELAYS INTO THE BRACES. PRIME BOTH, THEN DRAW HIS CHARGE AND STRIKE ONLY WHEN MY LINE HOLDS."
  message east_ready "CEESH: EAST RELAY STEADY. ONE MORE LINE WILL OPEN THE CHAMBER."
  message enemy_alert "BROWSER CHARGES - DODGE SIDEWAYS"
  message enemy_dropped_items "BROWSER DROPPED THE LAST OF HIS STOLEN RATIONS"
  message enemy_hit_warning "TAIL SWEEP - BACK AWAY"
  message enemy_vulnerable "CEESH'S FORGE LINE HOLDS - STRIKE NOW"
  message enemy_windup "BROWSER ROARS - MAKE SPACE"
  message guide_talk "E  TALK TO CEESH"
  message object_use "E  USE FORGE RELAY"
  message objective_browser_body "DODGE THE ROAR, CHARGE, AND TAIL SWEEP. ATTACK ONLY WHILE BROWSER IS STUNNED."
  message objective_browser_title "DEFEAT BROWSER"
  message objective_ceesh_body "MEET CEESH IN THE PREPARATION HALL."
  message objective_ceesh_title "PLAN THE LAST MOVE WITH CEESH"
  message objective_prepare_body "PRIME THE WEST AND EAST RELAYS. CEESH WILL OPEN THE SAFETY GATE."
  message objective_prepare_title "PRIME BOTH FORGE RELAYS"
  message objective_return_body "CROSS THE OPEN CROWN GATE AND STEP ONTO THE QUIET TERRACE."
  message objective_return_title "STEP INTO THE RESTORED ARCHIVE"
  message player_fallen "HAXIRIO HAS FALLEN"
  message return_prompt "E  RETURN TO THE CHAMBER"
  message scenario_title "Caxecraft: Browser's Last Stand"
  message speaker_ceesh_name "Ceesh"
  message victory_body "THE ARCHIVE BREATHES AGAIN. ITS CROWN DOOR STAYS OPEN FOR EVERY CREATOR."
  message victory_title "THE ARCHIVE, RESTORED"
  message west_ready "CEESH: WEST RELAY LOCKED. PRIME THE EAST LINE AND I WILL OPEN THE GATE."
end locale
locale es-mx
  message adventure_progress "ROMPE EL CONTROL DE BROWSER"
  message adventure_tagline "PREPARATE CON CEESH. LEE EL ATAQUE. GOLPEEN JUNTOS."
  message attack_hit "GOLPE DE HAXEFORJA"
  message browser_defeated "CEESH: EL ARCHIVO ES NUESTRO OTRA VEZ. TU ABRISTE EL CAMINO; LO TERMINAMOS JUNTOS."
  message ceesh_briefing "CEESH: CONECTE DOS RELEVADORES A LOS SOPORTES. ACTIVA AMBOS, ATRAE SU CARGA Y GOLPEA CUANDO MI LINEA LO DETENGA."
  message east_ready "CEESH: RELEVADOR ESTE ESTABLE. UNA LINEA MAS ABRIRA LA CAMARA."
  message enemy_alert "BROWSER CARGA - ESQUIVA A UN LADO"
  message enemy_dropped_items "BROWSER SOLTO SUS ULTIMAS RACIONES ROBADAS"
  message enemy_hit_warning "GOLPE DE COLA - RETROCEDE"
  message enemy_vulnerable "LA LINEA DE CEESH RESISTE - GOLPEA AHORA"
  message enemy_windup "BROWSER RUGE - ABRE ESPACIO"
  message guide_talk "E  HABLAR CON CEESH"
  message object_use "E  USAR RELEVADOR"
  message objective_browser_body "ESQUIVA EL RUGIDO, LA CARGA Y LA COLA. ATACA SOLO CUANDO BROWSER ESTE ATURDIDO."
  message objective_browser_title "DERROTA A BROWSER"
  message objective_ceesh_body "ENCUENTRA A CEESH EN LA SALA DE PREPARACION."
  message objective_ceesh_title "PLANEA EL ULTIMO MOVIMIENTO CON CEESH"
  message objective_prepare_body "ACTIVA LOS RELEVADORES OESTE Y ESTE. CEESH ABRIRA LA PUERTA DE SEGURIDAD."
  message objective_prepare_title "ACTIVA LOS DOS RELEVADORES"
  message objective_return_body "CRUZA LA PUERTA ABIERTA Y ENTRA EN LA TERRAZA TRANQUILA."
  message objective_return_title "ENTRA AL ARCHIVO RESTAURADO"
  message player_fallen "HAXIRIO HA CAIDO"
  message return_prompt "E  VOLVER A LA CAMARA"
  message scenario_title "Caxecraft: La ultima batalla de Browser"
  message speaker_ceesh_name "Ceesh"
  message victory_body "EL ARCHIVO RESPIRA OTRA VEZ. SU PUERTA QUEDA ABIERTA PARA CADA CREADOR."
  message victory_title "EL ARCHIVO, RESTAURADO"
  message west_ready "CEESH: RELEVADOR OESTE FIJO. ACTIVA LA LINEA ESTE Y ABRIRE LA PUERTA."
end locale
title message scenario_title
mode adventure
world 32 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
