CAXEMAP 1
feature required caxecraft:core
map adventure.forge-archive
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "OPEN THE FORGE ARCHIVE"
  message adventure_tagline "JOIN CEESH. FIX THE WEST MAP LINE AND EAST FORGE LINE. REACH BROWSER'S DOOR."
  message archive_cache_body "AN OLD NOTE FROM CEESH MARKS HIDDEN BERRIES BETWEEN THE SHELVES."
  message archive_cache_title "CEESH'S HIDDEN BERRIES"
  message boss_door_body "BROWSER IS PAST THE FINAL DOOR. CEESH SAYS TO GET READY TOGETHER BEFORE OPENING IT."
  message boss_door_title "BROWSER'S CLOSED ROOM"
  message ceesh_archive "I CAN HOLD THE MAIN LINE. FIX THE WEST MAP LINE AND THE EAST FORGE LINE."
  message central_early "THE CENTRAL HAXEFORGE NEEDS BOTH LINES."
  message central_ready "HAXIRIO MAKES THE PATH. CEESH HOLDS IT OPEN. THE INNER ARCHIVE UNLOCKS."
  message east_ready "THE EAST FORGE LINE TURNS ON. BROWSER'S WISP LOSES ITS SHIELD."
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "ATTACK COMING: DODGE"
  message enemy_windup "EMBER WISP GETS READY: DODGE"
  message guide_talk "E  TALK"
  message object_use "E  USE"
  message objective_branches_body "EXPLORE BOTH SIDE HALLS. FIX THE WEST MAP CONTROL AND THE EAST FORGE CONTROL."
  message objective_branches_title "FIX BOTH ARCHIVE LINES"
  message objective_ceesh_body "MEET CEESH AT THE MAIN ARCHIVE LINE."
  message objective_ceesh_title "JOIN CEESH IN THE ARCHIVE"
  message objective_door_body "CROSS THE OPEN INNER ARCHIVE. FIND BROWSER'S CLOSED DOOR."
  message objective_door_title "REACH BROWSER'S DOOR"
  message scenario_title "Caxecraft: Forge Archive"
  message speaker_ceesh_name "Ceesh"
  message west_ready "THE WEST MAP LINE TURNS ON. CEESH KEEPS THE ARCHIVE PATH OPEN."
end locale
locale es-mx
  message adventure_progress "ABRE EL ARCHIVO DE LA FORJA"
  message adventure_tagline "ÚNETE A CEESH. ARREGLA LA LÍNEA DEL MAPA Y LA LÍNEA DE LA FORJA. LLEGA A BROWSER."
  message archive_cache_body "UNA NOTA VIEJA DE CEESH MARCA BAYAS ESCONDIDAS ENTRE LOS ESTANTES."
  message archive_cache_title "BAYAS ESCONDIDAS DE CEESH"
  message boss_door_body "BROWSER ESTÁ DESPUÉS DE LA PUERTA FINAL. PREPARÉMONOS JUNTOS ANTES DE ABRIRLA."
  message boss_door_title "LA SALA CERRADA DE BROWSER"
  message ceesh_archive "YO PUEDO SOSTENER LA LÍNEA CENTRAL. ARREGLA LA LÍNEA DEL MAPA AL OESTE Y LA FORJA AL ESTE."
  message central_early "LA HAXEFORGE CENTRAL NECESITA LAS DOS LÍNEAS."
  message central_ready "HAXIRIO HACE EL CAMINO. CEESH LO MANTIENE ABIERTO. EL ARCHIVO INTERIOR SE ABRE."
  message east_ready "LA LÍNEA DE LA FORJA SE ENCIENDE. EL FUEGO FATUO DE BROWSER PIERDE SU ESCUDO."
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTÓ UNA LINTERNA"
  message enemy_hit_warning "VIENE UN ATAQUE: ESQUIVA"
  message enemy_windup "EL FUEGO FATUO SE PREPARA: ESQUIVA"
  message guide_talk "E  HABLAR"
  message object_use "E  USAR"
  message objective_branches_body "EXPLORA LOS DOS PASILLOS. ARREGLA EL MAPA AL OESTE Y LA FORJA AL ESTE."
  message objective_branches_title "ARREGLA LAS DOS LÍNEAS"
  message objective_ceesh_body "ENCUENTRA A CEESH EN LA LÍNEA CENTRAL DEL ARCHIVO."
  message objective_ceesh_title "ÚNETE A CEESH EN EL ARCHIVO"
  message objective_door_body "CRUZA EL ARCHIVO ABIERTO. ENCUENTRA LA PUERTA CERRADA DE BROWSER."
  message objective_door_title "LLEGA A LA PUERTA DE BROWSER"
  message scenario_title "Caxecraft: Archivo de la Forja"
  message speaker_ceesh_name "Ceesh"
  message west_ready "LA LÍNEA DEL MAPA SE ENCIENDE. CEESH MANTIENE ABIERTO EL CAMINO DEL ARCHIVO."
end locale
title message scenario_title
mode adventure
world 64 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
