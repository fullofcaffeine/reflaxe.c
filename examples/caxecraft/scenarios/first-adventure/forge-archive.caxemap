CAXEMAP 1
feature required caxecraft:core
map adventure.forge-archive
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "BREACH THE FORGE ARCHIVE"
  message adventure_tagline "JOIN CEESH. RESTORE TWO ARCHIVE LINES. REACH BROWSER'S DOOR."
  message archive_cache_body "CEESH'S OLD DESIGN NOTE MARKS A SAFE BERRY CACHE BETWEEN THE STACKS."
  message archive_cache_title "ARCHIVE DESIGN CACHE"
  message boss_door_body "BROWSER IS BEYOND THE FINAL DOOR. CEESH: WE PREPARE TOGETHER BEFORE WE OPEN IT."
  message boss_door_title "BROWSER'S SEALED CHAMBER"
  message ceesh_archive "CEESH: I CAN HOLD THE MAIN LINE. RESTORE THE WEST INDEX AND EAST FORGE BRANCHES."
  message central_early "THE CENTRAL HAXEFORGE NEEDS BOTH ARCHIVE BRANCHES."
  message central_ready "HAXIRIO SHAPES THE ROUTE WHILE CEESH HOLDS IT OPEN. THE INNER ARCHIVE UNLOCKS."
  message east_ready "THE FORGE LINE ANSWERS. BROWSER'S WISP LOSES ITS COVER."
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "EMBER WISP WINDUP: DODGE"
  message guide_talk "E  TALK"
  message object_use "E  USE"
  message objective_branches_body "EXPLORE BOTH SIDE HALLS. RESTORE THE WEST INDEX AND EAST FORGE CONTROLS."
  message objective_branches_title "RESTORE BOTH ARCHIVE BRANCHES"
  message objective_ceesh_body "MEET CEESH AT THE MAIN ARCHIVE LINE."
  message objective_ceesh_title "JOIN CEESH IN THE ARCHIVE"
  message objective_door_body "CROSS THE OPEN INNER ARCHIVE AND FIND BROWSER'S SEALED DOOR."
  message objective_door_title "REACH BROWSER'S DOOR"
  message scenario_title "Caxecraft: Forge Archive"
  message west_ready "THE INDEX LINE ANSWERS. CEESH KEEPS THE ARCHIVE MAP STABLE."
end locale
locale es-mx
  message adventure_progress "ABRE EL ARCHIVO DE LA FORJA"
  message adventure_tagline "UNETE A CEESH. RESTAURA DOS LINEAS. LLEGA A LA PUERTA DE BROWSER."
  message archive_cache_body "UNA NOTA ANTIGUA DE CEESH MARCA BAYAS SEGURAS ENTRE LOS ESTANTES."
  message archive_cache_title "RESERVA DE DISENO DEL ARCHIVO"
  message boss_door_body "BROWSER ESTA TRAS LA PUERTA FINAL. CEESH: NOS PREPARAMOS JUNTOS ANTES DE ABRIRLA."
  message boss_door_title "CAMARA SELLADA DE BROWSER"
  message ceesh_archive "CEESH: YO SOSTENGO LA LINEA CENTRAL. RESTAURA EL INDICE OESTE Y LA FORJA ESTE."
  message central_early "LA HAXEFORJA CENTRAL NECESITA LAS DOS LINEAS DEL ARCHIVO."
  message central_ready "HAXIRIO FORMA LA RUTA MIENTRAS CEESH LA SOSTIENE. EL ARCHIVO INTERIOR SE ABRE."
  message east_ready "LA LINEA DE LA FORJA RESPONDE. EL FUEGO FATUO DE BROWSER PIERDE SU COBERTURA."
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTO UNA LINTERNA"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "FUEGO FATUO CARGANDO: ESQUIVA"
  message guide_talk "E  HABLAR"
  message object_use "E  USAR"
  message objective_branches_body "EXPLORA LOS DOS PASILLOS. RESTAURA EL INDICE OESTE Y LA FORJA ESTE."
  message objective_branches_title "RESTAURA LAS DOS LINEAS"
  message objective_ceesh_body "ENCUENTRA A CEESH EN LA LINEA CENTRAL DEL ARCHIVO."
  message objective_ceesh_title "UNETE A CEESH EN EL ARCHIVO"
  message objective_door_body "CRUZA EL ARCHIVO ABIERTO Y ENCUENTRA LA PUERTA SELLADA DE BROWSER."
  message objective_door_title "LLEGA A LA PUERTA DE BROWSER"
  message scenario_title "Caxecraft: Archivo de la Forja"
  message west_ready "LA LINEA DEL INDICE RESPONDE. CEESH MANTIENE ESTABLE EL MAPA DEL ARCHIVO."
end locale
title message scenario_title
mode adventure
world 64 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
