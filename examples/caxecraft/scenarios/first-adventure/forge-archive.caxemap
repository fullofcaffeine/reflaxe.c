fluid archive.forge-coolant caxecraft:water volume 42 5 15 1 1 5
object archive.boss-gate
  tag destination
  tag mechanism
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 32500 5000 1500 0
end object
object archive.ceesh-line
  tag collaboration
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 34500 5000 26500 0
end object
object archive.central-haxeforge
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 32500 5000 12500 0
end object
object archive.east-forge
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 55500 5000 13500 270
end object
object archive.inner-gate
  tag mechanism
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 32500 5000 10500 0
end object
object archive.west-index
  tag mechanism
  placement stateful caxecraft:gate-winch caxecraft:waiting 5500 5000 13500 90
end object
object enemy.archive-wisp
  tag enemy
  placement entity caxecraft:ember-wisp 50500 5000 20500 180
end object
object guide.ceesh
  tag friend
  tag engineer
  placement npc caxecraft:ceesh dialogue.ceesh.archive 31500 5000 26500 0
end object
object item.archive-cache
  tag discovery
  tag reward
  tag secret
  placement item caxecraft:berries 3 5500 5000 22500 0
end object
object player.start
  tag player
  placement player-spawn 32500 5000 29500 0
end object
object zone.browser-threshold
  tag destination
  placement trigger-zone 28 4 2 9 8 7
end object
dialogue dialogue.archive-cache
  line speaker guide.ceesh message archive_cache_body
end dialogue
dialogue dialogue.browser-threshold
  line speaker guide.ceesh message boss_door_body
end dialogue
dialogue dialogue.ceesh.archive
  line speaker guide.ceesh message ceesh_archive
end dialogue
dialogue dialogue.central.early
  line speaker guide.ceesh message central_early
end dialogue
dialogue dialogue.central.ready
  line speaker guide.ceesh message central_ready
end dialogue
dialogue dialogue.east.ready
  line speaker guide.ceesh message east_ready
end dialogue
dialogue dialogue.west.ready
  line speaker guide.ceesh message west_ready
end dialogue
journal journal.archive-cache title message archive_cache_title
  body message archive_cache_body
end journal
journal journal.browser-threshold title message boss_door_title
  body message boss_door_body
end journal
objective objective.join-ceesh active title message objective_ceesh_title
  body message objective_ceesh_body
end objective
objective objective.reach-browser hidden title message objective_door_title
  body message objective_door_body
end objective
objective objective.restore-branches hidden title message objective_branches_title
  body message objective_branches_body
end objective
variable quest.archive-cache-found quest flag false
variable quest.ceesh-holding-line quest flag false
variable quest.east-forge-ready quest flag false
variable quest.west-index-ready quest flag false
rule rule.archive-cache-found priority 70 once
  when collect-item caxecraft:berries
  if (flag quest.archive-cache-found false)
  do set-flag quest.archive-cache-found true
  do dialogue dialogue.archive-cache
  do journal journal.archive-cache
end rule
rule rule.browser-threshold-reached priority 100 once
  when enter-zone zone.browser-threshold
  if (objective objective.reach-browser active)
  do dialogue dialogue.browser-threshold
  do journal journal.browser-threshold
  do objective objective.reach-browser complete
end rule
rule rule.ceesh-holds-main-line priority 100 once
  when interact guide.ceesh
  if (objective objective.join-ceesh active)
  do set-flag quest.ceesh-holding-line true
  do set-object-state archive.ceesh-line caxecraft:entered
  do dialogue dialogue.ceesh.archive
  do objective objective.join-ceesh complete
  do objective objective.restore-branches active
end rule
rule rule.central-forge-needs-both-branches priority 90 repeat
  when interact archive.central-haxeforge
  if (not (all (flag quest.east-forge-ready true) (flag quest.west-index-ready true)))
  do dialogue dialogue.central.early
end rule
rule rule.central-forge-opens-inner-archive priority 100 once
  when interact archive.central-haxeforge
  if (all (flag quest.ceesh-holding-line true) (flag quest.east-forge-ready true) (flag quest.west-index-ready true))
  do set-object-state archive.central-haxeforge caxecraft:entered
  do set-object-state archive.inner-gate caxecraft:open
  do dialogue dialogue.central.ready
  do objective objective.restore-branches complete
  do objective objective.reach-browser active
end rule
rule rule.east-forge-restored priority 100 once
  when interact archive.east-forge
  if (all (objective objective.restore-branches active) (flag quest.east-forge-ready false))
  do set-flag quest.east-forge-ready true
  do set-object-state archive.east-forge caxecraft:entered
  do dialogue dialogue.east.ready
end rule
rule rule.west-index-restored priority 100 once
  when interact archive.west-index
  if (all (objective objective.restore-branches active) (flag quest.west-index-ready false))
  do set-flag quest.west-index-ready true
  do set-object-state archive.west-index caxecraft:entered
  do dialogue dialogue.west.ready
end rule
end-map
