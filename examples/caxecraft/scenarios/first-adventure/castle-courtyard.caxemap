CAXEMAP 1
feature required caxecraft:core
map adventure.castle-courtyard
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "BREACH THE CASTLE COURTYARD"
  message adventure_tagline "READ CEESH'S NOTE. SET BOTH TOWERS. ENTER THE KEEP."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "BERRIES FULL: USE ONE FIRST"
  message block_stack_full "BLOCK STACK FULL: USE ONE FIRST"
  message ceesh_castle "CEESH: GOOD, YOU FOUND MY BYPASS. I JAMMED THE FORGE LIFT BEFORE BROWSER COULD FEED IT ANOTHER BAD BUILD. NOW HELP ME FIND A SECOND WAY INTO THE ARCHIVE."
  message ceesh_note "CEESH'S NOTE: BROWSER CHAINED THE COURTYARD GATE TO BOTH TOWERS. I CUT THE LOCK'S ORDER CHECK. SET THE WEST COUNTERWEIGHT AND EAST RELAY IN EITHER ORDER. - CEESH"
  message courtyard_open "THE TWO TOWERS ANSWER TOGETHER. THE SABOTAGED COURTYARD GATE OPENS."
  message east_ready "THE EAST RELAY HUMS. SET THE WEST COUNTERWEIGHT."
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "TELEGRAPHED HIT: DODGE THE NEXT"
  message enemy_windup "EMBER WISP WINDUP: DODGE"
  message guide_talk "E  TALK"
  message inner_keep_body "CEESH'S TOOLS ARE WEDGED INTO THE INNER DOOR. THE FORGE LIFT IS DISABLED, BUT BROWSER SEALED HIMSELF IN THE ARCHIVE. CEESH NEEDS A SECOND ROUTE."
  message inner_keep_title "THE INNER KEEP"
  message lantern_found "A CASTLE LAMPLIGHTER HID A SPARE LANTERN IN THE WESTERN NOOK."
  message lantern_title "THE LAMPLIGHTER'S NOOK"
  message object_use "E  USE"
  message objective_controls_body "SET THE WEST COUNTERWEIGHT AND EAST RELAY. CEESH REMOVED THE ORDER CHECK, SO EITHER CONTROL MAY COME FIRST."
  message objective_controls_title "SET BOTH TOWER CONTROLS"
  message objective_enter_body "PASS THROUGH THE OPEN OUTER GATE, CROSS THE COURTYARD, AND INSPECT THE SEALED INNER GATE."
  message objective_enter_title "REACH THE INNER KEEP"
  message objective_note_body "CEESH LEFT A FIELD NOTE BESIDE THE ASHFALL ROAD."
  message objective_note_title "READ CEESH'S FIELD NOTE"
  message scenario_title "Caxecraft: Castle Courtyard"
  message west_ready "THE WEST COUNTERWEIGHT DROPS. SET THE EAST RELAY."
end locale
locale es-mx
  message adventure_progress "IRRUMPE EN EL PATIO DEL CASTILLO"
  message adventure_tagline "LEE LA NOTA DE CEESH. ACTIVA DOS TORRES. LLEGA AL TORREON."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "BAYAS LLENAS: USA UNA PRIMERO"
  message block_stack_full "PILA DE BLOQUES LLENA: USA UNO"
  message ceesh_castle "CEESH: BIEN, ENCONTRASTE MI DESVIO. BLOQUEE EL ELEVADOR DE LA FORJA ANTES DE QUE BROWSER LE DIERA OTRA COMPILACION MALA. AHORA AYUDAME A HALLAR OTRA RUTA AL ARCHIVO."
  message ceesh_note "NOTA DE CEESH: BROWSER UNIO LA REJA DEL PATIO A LAS DOS TORRES. CORTE LA REVISION DE ORDEN. ACTIVA EL CONTRAPESO OESTE Y EL RELE ESTE EN CUALQUIER ORDEN. - CEESH"
  message courtyard_open "LAS DOS TORRES RESPONDEN JUNTAS. LA REJA SABOTEADA DEL PATIO SE ABRE."
  message east_ready "EL RELE ESTE ZUMBA. ACTIVA EL CONTRAPESO OESTE."
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTO UNA LINTERNA"
  message enemy_hit_warning "ATAQUE AVISADO: ESQUIVA EL PROXIMO"
  message enemy_windup "FUEGO FATUO CARGANDO: ESQUIVA"
  message guide_talk "E  HABLAR"
  message inner_keep_body "LAS HERRAMIENTAS DE CEESH TRABAN LA PUERTA INTERIOR. EL ELEVADOR DE LA FORJA ESTA DESACTIVADO, PERO BROWSER SE ENCERRO EN EL ARCHIVO. CEESH NECESITA OTRA RUTA."
  message inner_keep_title "EL TORREON INTERIOR"
  message lantern_found "UN FAROLERO DEL CASTILLO ESCONDIO UNA LINTERNA EN EL RINCON OESTE."
  message lantern_title "EL RINCON DEL FAROLERO"
  message object_use "E  USAR"
  message objective_controls_body "ACTIVA EL CONTRAPESO OESTE Y EL RELE ESTE. CEESH QUITO LA REVISION DE ORDEN, ASI QUE PUEDES EMPEZAR POR CUALQUIERA."
  message objective_controls_title "ACTIVA LOS DOS CONTROLES"
  message objective_enter_body "CRUZA LA REJA EXTERIOR Y EL PATIO. EXAMINA LA REJA SELLADA DEL TORREON."
  message objective_enter_title "LLEGA AL TORREON INTERIOR"
  message objective_note_body "CEESH DEJO UNA NOTA JUNTO AL CAMINO DE ASHFALL."
  message objective_note_title "LEE LA NOTA DE CEESH"
  message scenario_title "Caxecraft: Patio del Castillo"
  message west_ready "EL CONTRAPESO OESTE CAE. ACTIVA EL RELE ESTE."
end locale
title message scenario_title
mode adventure
world 32 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
