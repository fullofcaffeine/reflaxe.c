CAXEMAP 1
feature required caxecraft:core
map adventure.castle-courtyard
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "ENTER THE CASTLE COURTYARD"
  message adventure_tagline "READ CEESH'S NOTE. USE BOTH CONTROLS. OPEN THE INNER GATE."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "NO ROOM FOR MORE BERRIES: USE ONE FIRST"
  message block_stack_full "NO ROOM FOR MORE BLOCKS: USE ONE FIRST"
  message ceesh_castle "I STOPPED THE FORGE LIFT. OPEN THIS LOCK. THEN TAKE MY WORK TUNNEL INTO THE UNDERWORKS."
  message ceesh_note "I FIXED THE CONTROLS. NOW THEY WORK IN ANY ORDER. TURN THE WEST WHEEL AND THE EAST SWITCH."
  message courtyard_open "BOTH CONTROLS ARE READY. THE COURTYARD GATE OPENS."
  message east_ready "THE EAST SWITCH LIGHTS UP. TURN THE WEST WHEEL."
  message enemy_alert "EMBER WISP ALERT"
  message enemy_dropped_items "THE EMBER WISP DROPPED A LANTERN"
  message enemy_hit_warning "ATTACK COMING: DODGE"
  message enemy_windup "EMBER WISP GETS READY: DODGE"
  message guide_talk "E  TALK"
  message inner_keep_body "CEESH'S WORK TUNNEL OPENS THE INNER GATE. FOLLOW IT INTO THE CASTLE UNDERWORKS."
  message inner_keep_title "THE INNER CASTLE"
  message lantern_found "SOMEONE HID A SPARE LANTERN IN THE WEST CORNER."
  message lantern_title "THE HIDDEN LANTERN"
  message object_use "E  USE"
  message objective_controls_body "TURN THE WEST WHEEL AND THE EAST SWITCH. YOU CAN USE EITHER ONE FIRST."
  message objective_controls_title "USE BOTH TOWER CONTROLS"
  message objective_enter_body "GO THROUGH THE OUTER GATE. CROSS THE COURTYARD. FIND THE CLOSED INNER GATE."
  message objective_enter_title "REACH THE INNER CASTLE"
  message objective_note_body "CEESH LEFT A NOTE BESIDE THE ASHFALL ROAD."
  message objective_note_title "READ CEESH'S NOTE"
  message objective_underworks_body "GO THROUGH THE INNER GATE. ENTER CEESH'S WORK TUNNEL."
  message objective_underworks_title "ENTER THE CASTLE UNDERWORKS"
  message scenario_title "Caxecraft: Castle Courtyard"
  message speaker_ceesh_name "Ceesh"
  message west_ready "THE WEST WHEEL LOCKS. USE THE EAST SWITCH."
end locale
locale es-mx
  message adventure_progress "ENTRA AL PATIO DEL CASTILLO"
  message adventure_tagline "LEE LA NOTA DE CEESH. USA LOS DOS CONTROLES. ABRE LA PUERTA INTERIOR."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "NO CABEN MÁS BAYAS: USA UNA PRIMERO"
  message block_stack_full "NO CABEN MÁS BLOQUES: USA UNO PRIMERO"
  message ceesh_castle "DETUVÉ EL ELEVADOR DE LA FORJA. ABRE ESTA CERRADURA. DESPUÉS SIGUE MI TÚNEL HASTA LA PARTE BAJA DEL CASTILLO."
  message ceesh_note "ARREGLÉ LOS CONTROLES. AHORA FUNCIONAN EN CUALQUIER ORDEN. GIRA LA RUEDA OESTE Y USA EL INTERRUPTOR ESTE."
  message courtyard_open "LOS DOS CONTROLES ESTÁN LISTOS. LA PUERTA DEL PATIO SE ABRE."
  message east_ready "EL INTERRUPTOR ESTE SE ENCIENDE. GIRA LA RUEDA OESTE."
  message enemy_alert "FUEGO FATUO ALERTA"
  message enemy_dropped_items "EL FUEGO FATUO SOLTÓ UNA LINTERNA"
  message enemy_hit_warning "VIENE UN ATAQUE: ESQUIVA"
  message enemy_windup "EL FUEGO FATUO SE PREPARA: ESQUIVA"
  message guide_talk "E  HABLAR"
  message inner_keep_body "EL TÚNEL DE CEESH ABRE LA PUERTA INTERIOR. SÍGUELO HASTA LOS TÚNELES DEL CASTILLO."
  message inner_keep_title "EL CASTILLO INTERIOR"
  message lantern_found "ALGUIEN ESCONDIÓ UNA LINTERNA EN EL RINCÓN OESTE."
  message lantern_title "LA LINTERNA ESCONDIDA"
  message object_use "E  USAR"
  message objective_controls_body "GIRA LA RUEDA OESTE Y USA EL INTERRUPTOR ESTE. PUEDES EMPEZAR POR CUALQUIERA."
  message objective_controls_title "USA LOS DOS CONTROLES"
  message objective_enter_body "PASA POR LA PUERTA EXTERIOR. CRUZA EL PATIO. BUSCA LA PUERTA INTERIOR CERRADA."
  message objective_enter_title "LLEGA AL CASTILLO INTERIOR"
  message objective_note_body "CEESH DEJÓ UNA NOTA JUNTO AL CAMINO DE ASHFALL."
  message objective_note_title "LEE LA NOTA DE CEESH"
  message objective_underworks_body "PASA POR LA PUERTA INTERIOR. ENTRA AL TÚNEL DE TRABAJO DE CEESH."
  message objective_underworks_title "ENTRA A LOS TÚNELES DEL CASTILLO"
  message scenario_title "Caxecraft: Patio del Castillo"
  message speaker_ceesh_name "Ceesh"
  message west_ready "LA RUEDA OESTE SE FIJA. USA EL INTERRUPTOR ESTE."
end locale
title message scenario_title
mode adventure
world 32 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 5 caxecraft:wood
palette 8 caxecraft:ash
palette 9 caxecraft:stone
