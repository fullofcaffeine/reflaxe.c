fluid castle.moat-east caxecraft:water volume 20 5 23 5 1 2
fluid castle.moat-west caxecraft:water volume 8 5 23 5 1 2
object castle.ceesh-note
  tag clue
  placement stateful caxecraft:ceesh-field-note caxecraft:waiting 12500 5000 27500 0
end object
object castle.east-relay
  tag mechanism
  placement stateful caxecraft:gate-relay caxecraft:waiting 26500 5000 25500 270
end object
object castle.inner-gate
  tag landmark
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 16500 5000 8500 0
end object
object castle.inner-lock
  tag clue
  placement stateful caxecraft:gate-relay caxecraft:waiting 15500 5000 10500 0
end object
object castle.outer-gate
  tag mechanism
  placement stateful caxecraft:castle-portcullis caxecraft:sealed 16500 5000 21500 0
end object
object castle.west-winch
  tag mechanism
  placement stateful caxecraft:gate-winch caxecraft:waiting 6500 5000 25500 90
end object
object enemy.courtyard-wisp
  tag enemy
  placement entity caxecraft:ember-wisp 24500 5000 16500 180
end object
object guide.ceesh
  tag friend
  placement npc caxecraft:ceesh dialogue.ceesh.castle 18500 5000 9500 270
end object
object item.lamplighter-lantern
  tag secret
  placement item caxecraft:lantern 1 6500 5000 14500 0
end object
object player.start
  tag player
  placement player-spawn 16500 5000 29500 180
end object
dialogue dialogue.ceesh-note
  line speaker guide.ceesh message ceesh_note
end dialogue
dialogue dialogue.ceesh.castle
  line speaker guide.ceesh message ceesh_castle
end dialogue
dialogue dialogue.courtyard-open
  line speaker guide.ceesh message courtyard_open
end dialogue
dialogue dialogue.east-ready
  line speaker guide.ceesh message east_ready
end dialogue
dialogue dialogue.inner-keep
  line speaker guide.ceesh message inner_keep_body
end dialogue
dialogue dialogue.lantern-found
  line speaker guide.ceesh message lantern_found
end dialogue
dialogue dialogue.west-ready
  line speaker guide.ceesh message west_ready
end dialogue
journal journal.inner-keep title message inner_keep_title
  body message inner_keep_body
end journal
journal journal.lamplighter-nook title message lantern_title
  body message lantern_found
end journal
objective objective.enter-keep hidden title message objective_enter_title
  body message objective_enter_body
end objective
objective objective.read-note active title message objective_note_title
  body message objective_note_body
end objective
objective objective.set-controls hidden title message objective_controls_title
  body message objective_controls_body
end objective
variable quest.east-relay-ready quest flag false
variable quest.lamplighter-nook-found quest flag false
variable quest.west-winch-ready quest flag false
rule rule.ceesh-note-read priority 100 once
  when interact castle.ceesh-note
  if (objective objective.read-note active)
  do set-object-state castle.ceesh-note caxecraft:entered
  do dialogue dialogue.ceesh-note
  do objective objective.read-note complete
  do objective objective.set-controls active
end rule
rule rule.courtyard-opens-from-east priority 110 once
  when state-changed quest.east-relay-ready
  if (all (flag quest.east-relay-ready true) (flag quest.west-winch-ready true))
  do set-object-state castle.outer-gate caxecraft:open
  do dialogue dialogue.courtyard-open
  do objective objective.set-controls complete
  do objective objective.enter-keep active
end rule
rule rule.courtyard-opens-from-west priority 110 once
  when state-changed quest.west-winch-ready
  if (all (flag quest.east-relay-ready true) (flag quest.west-winch-ready true))
  do set-object-state castle.outer-gate caxecraft:open
  do dialogue dialogue.courtyard-open
  do objective objective.set-controls complete
  do objective objective.enter-keep active
end rule
rule rule.east-relay-set priority 100 once
  when interact castle.east-relay
  if (flag quest.east-relay-ready false)
  do set-flag quest.east-relay-ready true
  do set-object-state castle.east-relay caxecraft:entered
  do dialogue dialogue.east-ready
end rule
rule rule.inner-keep-inspected priority 100 once
  when interact castle.inner-lock
  if (objective objective.enter-keep active)
  do set-object-state castle.inner-lock caxecraft:entered
  do dialogue dialogue.inner-keep
  do journal journal.inner-keep
  do objective objective.enter-keep complete
end rule
rule rule.lamplighter-nook-found priority 100 once
  when collect-item caxecraft:lantern
  if (flag quest.lamplighter-nook-found false)
  do set-flag quest.lamplighter-nook-found true
  do dialogue dialogue.lantern-found
  do journal journal.lamplighter-nook
end rule
rule rule.west-winch-set priority 100 once
  when interact castle.west-winch
  if (flag quest.west-winch-ready false)
  do set-flag quest.west-winch-ready true
  do set-object-state castle.west-winch caxecraft:entered
  do dialogue dialogue.west-ready
end rule
end-map
