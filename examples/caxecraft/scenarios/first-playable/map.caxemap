fluid water.evergrove-stream-north caxecraft:water volume 4 3 0 3 2 21
fluid water.evergrove-stream-source caxecraft:water source 4 4 4
fluid water.evergrove-stream-south caxecraft:water volume 4 3 23 3 2 9
fluid water.evergrove-stream-under-bridge caxecraft:water volume 4 3 21 3 1 2
fluid water.village-well caxecraft:water volume 12 5 22 1 1 1
object enemy.mossling
  tag enemy
  placement entity caxecraft:mossling 15500 5000 13800 0
end object
object guide.nia
  tag friend
  placement npc caxecraft:nia dialogue.nia.welcome 17500 5000 13500 270
end object
object item.nia-berries
  tag gift
  placement item caxecraft:berries 2 17500 5000 14500 0
end object
object item.tideweave
  tag deferred-vault-proof
  tag mechanics-proof
  tag quest
  placement item caxecraft:tideweave-suit 1 4500 5000 4500 0
end object
object player.start
  tag player
  placement player-spawn 16500 5000 16500 0
end object
dialogue dialogue.nia.welcome
  line speaker guide.nia message guide_welcome
end dialogue
objective objective.explore hidden title literal "FIND THE TIDEWEAVE SUIT"
  body literal "Search beyond the village and test the water route."
end objective
objective objective.prologue active title message adventure_progress
  body message adventure_tagline
end objective
rule rule.nia-starts-exploration priority 100 once
  when interact guide.nia
  if (always)
  do dialogue dialogue.nia.welcome
  do objective objective.prologue complete
  do objective objective.explore active
end rule
end-map
