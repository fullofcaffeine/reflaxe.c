CAXEMAP 1
feature required caxecraft:core
map adventure.first-playable
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_progress "ASK NIA ABOUT THE WESTERN ROAD"
  message adventure_tagline "CEESH WENT WEST BY THE RIVER. NIA KNOWS THE WAY."
  message attack_hit "COPPER STRIKE"
  message berry_stack_full "NO ROOM FOR MORE BERRIES: USE ONE FIRST"
  message block_stack_full "NO ROOM FOR MORE BLOCKS: USE ONE FIRST"
  message enemy_alert "MOSSLING ALERT"
  message enemy_dropped_items "MOSSLING DROPPED BERRIES"
  message enemy_hit_warning "ATTACK COMING: DODGE"
  message enemy_windup "MOSSLING GETS READY: DODGE"
  message guide_talk "E  TALK TO NIA"
  message guide_welcome "BROWSER TOOK CEESH TO THE FORGE ARCHIVE. FOLLOW THE RIVER WEST. I LEFT BERRIES FOR YOU."
  message object_use "E  USE"
  message objective_west_body "GO THROUGH EVERGROVE'S WEST GATE. FOLLOW THE RIVER TO THE FALLS."
  message objective_west_title "FOLLOW CEESH'S TRAIL WEST"
  message pickup_many "+2 BERRIES"
  message pickup_one "+1 BERRY"
  message player_fallen "HAXIRIO FELL"
  message recovery_empty "NO BERRIES LEFT"
  message recovery_used "BERRIES: +1 HEART"
  message return_prompt "E  RETURN TO THE MEADOW"
  message scenario_title "Caxecraft: Evergrove"
  message speaker_nia_name "Nia"
end locale
locale es-mx
  message adventure_progress "PREGUNTA A NIA POR EL CAMINO AL OESTE"
  message adventure_tagline "CEESH FUE AL OESTE POR EL RÍO. NIA CONOCE EL CAMINO."
  message attack_hit "GOLPE DE COBRE"
  message berry_stack_full "NO CABEN MÁS BAYAS: USA UNA PRIMERO"
  message block_stack_full "NO CABEN MÁS BLOQUES: USA UNO PRIMERO"
  message enemy_alert "MUSGUITO ALERTA"
  message enemy_dropped_items "EL MUSGUITO SOLTÓ BAYAS"
  message enemy_hit_warning "VIENE UN ATAQUE: ESQUIVA"
  message enemy_windup "EL MUSGUITO SE PREPARA: ESQUIVA"
  message guide_talk "E  HABLAR CON NIA"
  message guide_welcome "BROWSER SE LLEVÓ A CEESH AL ARCHIVO DE LA FORJA. SIGUE EL RÍO AL OESTE. DEJÉ BAYAS PARA TI."
  message object_use "E  USAR"
  message objective_west_body "PASA POR LA PUERTA OESTE DE EVERGROVE. SIGUE EL RÍO HASTA LAS CATARATAS."
  message objective_west_title "SIGUE EL RASTRO DE CEESH AL OESTE"
  message pickup_many "+2 BAYAS"
  message pickup_one "+1 BAYA"
  message player_fallen "HAXIRIO CAYÓ"
  message recovery_empty "NO QUEDAN BAYAS"
  message recovery_used "BAYAS: +1 CORAZÓN"
  message return_prompt "E  VOLVER AL PRADO"
  message scenario_title "Caxecraft: Evergrove"
  message speaker_nia_name "Nia"
end locale
title message scenario_title
mode adventure
environment voxel-horizon
  sky 126 190 201
  sun 54 31 -76 3400
  clouds 4 600 817
  edges north south east west
  continue-water true
end environment
world 32 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
palette 2 caxecraft:dirt
palette 3 caxecraft:grass
palette 4 caxecraft:sand
palette 5 caxecraft:wood
palette 6 caxecraft:leaves
palette 7 caxecraft:snow
palette 8 caxecraft:ash
palette 9 caxecraft:stone
