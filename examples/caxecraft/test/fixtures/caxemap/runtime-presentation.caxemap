CAXEMAP 1
feature required caxecraft:core
map qa.runtime-presentation
asset-pack packs/caxecraft/base
default-locale en
locale en
  message adventure_tagline "A runtime-authored adventure"
  message journal.body "Keep the clue available after dialogue closes."
  message journal.title "Runtime journal clue"
  message objective.body "Cross the test bridge."
  message objective.title "Reach the test marker"
  message scenario.title "Runtime presentation probe"
end locale
locale es-mx
  message adventure_tagline "Una aventura creada en tiempo de ejecucion"
  message journal.body "Conserva la pista despues de cerrar el dialogo."
  message journal.title "Pista del diario en ejecucion"
  message objective.body "Cruza el puente de prueba."
  message objective.title "Llega al marcador de prueba"
  message scenario.title "Prueba de presentacion en ejecucion"
end locale
title message scenario.title
mode adventure
world 32 16 32
palette 0 caxecraft:air
palette 1 caxecraft:bedrock
chunk world.base 0 0 0 32 16 32
  run 1 32
  run 0 16352
end chunk
object guide.nia
  tag friend
  placement npc caxecraft:nia dialogue.guide 2500 1000 1500 270
end object
object item.fixture-lantern
  tag reward
  placement item caxecraft:lantern 1 1500 1000 1500 0
end object
object item.fixture-tideweave
  tag equipment
  placement item caxecraft:tideweave-suit 1 1500 1000 1500 0
end object
object object.glyph-control
  tag interaction
  placement stateful caxecraft:glyph-control caxecraft:active 2500 1000 1500 0
end object
object player.start
  tag player
  placement player-spawn 1500 1000 1500 0
end object
dialogue dialogue.guide
  line speaker guide.nia literal "Synthetic engine fixture"
end dialogue
journal journal.fixture title message journal.title
  body message journal.body
end journal
objective objective.marker active title message objective.title
  body message objective.body
end objective
objective objective.next hidden title literal "Inspect the engine result"
  body literal "This objective exists only to prove generic runtime progression."
end objective
objective objective.collected hidden title literal "Collection reached authored rules"
  body literal "A committed item pickup selected this objective."
end objective
objective objective.equipped hidden title literal "Equipment reached authored rules"
  body literal "A committed aquatic-equipment pickup selected this objective."
end objective
rule rule.fixture-advance priority 10 once
  when interact guide.nia
  if (always)
  do journal journal.fixture
  do objective objective.marker complete
  do objective objective.next active
end rule
rule rule.fixture-glyph priority 10 repeat
  when interact object.glyph-control
  if (object-state object.glyph-control caxecraft:active)
  do set-object-state object.glyph-control caxecraft:idle
end rule
rule rule.fixture-collect priority 10 repeat
  when collect-item caxecraft:lantern
  if (always)
  do objective objective.next complete
  do objective objective.collected active
end rule
rule rule.fixture-equip priority 10 once
  when collect-item caxecraft:tideweave-suit
  if (always)
  do objective objective.collected complete
  do objective objective.equipped active
end rule
end-map
