PILOSCRIPT 1
name browser-chamber-journey
frames 500

# Open Adventure, select the reloadable finale, and accept Ceesh's plan.
action 0 menu-next
checkpoint 0 capture title-selection
action 1 menu-confirm
checkpoint 1 capture campaign-selection
action 2 menu-next
action 4 menu-next
action 6 menu-next
action 8 menu-next
action 10 menu-next
action 12 menu-next
checkpoint 13 capture level-selection
action 14 menu-confirm
expect 20 screen playing
expect 20 mode adventure
expect 20 level browser-chamber
expect 20 objective objective.join-ceesh
action 22 interact
action 27 interact
expect 30 objective objective.prepare-arena
action 32 interact

# Prime the two forge relays and enter the chamber. The journey protects the
# route's milestones; free play owns timing, visual feel, and combat tuning.
hold 34 72 left
hold 73 86 forward
action 88 interact
action 93 interact
action 98 interact
hold 100 113 backward
hold 115 194 right
hold 195 202 forward
action 204 interact
action 209 interact
action 214 interact
expect 216 objective objective.confront-browser
expect 216 object-state arena.entry-gate=caxecraft:open
hold 217 254 left
hold 255 296 forward
hold 304 311 right
hold 312 319 left
hold 331 347 forward
action 348 select-sword
action 349 strike
action 355 strike
action 361 strike
action 367 strike
action 373 strike
action 379 strike
action 385 strike
expect 395 objective objective.return-to-ceesh
expect 395 object-state arena.exit-gate=caxecraft:open
action 396 interact
action 401 interact
hold 402 470 forward
hold 471 490 left
expect 494 objective none
expect 494 dialogue dialogue.victory
expect 494 journal journal.victory
checkpoint 497 capture final
end
