PILOSCRIPT 1
name browser-chamber-journey
frames 500

# Open Adventure, select the reloadable finale, and accept Ceesh's plan.
action 0 menu-next
checkpoint 0 capture title-selection
action 1 menu-confirm
checkpoint 1 capture campaign-selection
action 2 menu-next
action 4 menu-next
action 6 menu-next
action 8 menu-next
action 10 menu-next
checkpoint 11 capture level-selection
action 12 menu-confirm
expect 20 screen playing
expect 20 mode adventure
expect 20 level browser-chamber
expect 20 objective objective.join-ceesh
action 22 interact
action 27 interact
expect 30 objective objective.prepare-arena

# Prime the two forge relays and enter the chamber. The journey protects the
# route's milestones; free play owns timing, visual feel, and combat tuning.
hold 31 46 forward
hold 47 84 left
action 86 interact
action 91 interact
hold 92 167 right
action 169 interact
action 174 interact
expect 180 objective objective.confront-browser
expect 180 object-state arena.entry-gate=caxecraft:open
hold 181 218 left
hold 219 260 forward
hold 268 275 right
hold 276 283 left
hold 300 306 forward
action 307 select-sword
action 308 strike
action 314 strike
action 320 strike
action 326 strike
action 332 strike
action 338 strike
expect 354 objective objective.return-to-ceesh
expect 354 object-state arena.exit-gate=caxecraft:open
action 355 interact
hold 356 424 forward
hold 425 444 left
expect 448 objective none
expect 448 dialogue dialogue.victory
expect 448 journal journal.victory
hold 449 495 turn-right
checkpoint 497 capture final
end
