PILOSCRIPT 1
name adventure-journey
frames 351

# Move from Creative to Adventure, then open the staged campaign.
action 0 menu-next
checkpoint 0 capture title-selection
expect 0 screen title
expect 0 mode adventure

action 1 menu-confirm
checkpoint 1 capture campaign-selection
expect 1 screen campaign
expect 1 level evergrove

# Select Western Falls and launch it through the campaign screen.
action 2 menu-next
checkpoint 2 capture level-selection
expect 2 screen campaign
expect 2 level western-falls

action 3 menu-confirm
expect 3 screen playing
expect 3 mode adventure
expect 3 level western-falls
expect 3 objective objective.meet-moss
expect 3 generation 2
expect 3 publications 1

# Ask Moss about the four marks, then leave the Falls spawn.
action 4 interact
expect 8 objective objective.find-tideweave
expect 8 dialogue dialogue.moss.falls
expect 8 journal journal.fallskeeper-lead

# Open the sand seam and reach the lower cache.
hold 5 92 forward-left
hold 93 98 look-left
action 99 mine
hold 100 135 forward-rise
hold 136 151 rise

# At this point the route has opened the sand seam and equipped Tideweave.
expect 153 sand 1
expect 153 position 5,3,21

# Cross the opened lower cache, equip Tideweave, and enter the flooded grotto.
hold 152 167 right
expect 171 equipment caxecraft:tideweave-suit
expect 171 objective objective.explore-grotto
expect 171 sand 1
hold 172 227 backward
hold 228 311 left-descend
expect 312 equipment caxecraft:tideweave-suit
expect 312 objective none
expect 312 lanterns 2
expect 312 sand 1
expect 312 medium submerged
expect 312 position 13,3,25
hold 312 343 right-rise

action 349 pause
checkpoint 349 capture final
expect 349 screen paused
expect 349 level western-falls
expect 349 objective none
expect 349 equipment caxecraft:tideweave-suit
expect 349 lanterns 2
expect 349 sand 1
expect 349 medium dry
expect 349 position 13,6,22
end
