PILOSCRIPT 1
name adventure-journey
frames 380

# Move from Creative to Adventure, then open the staged campaign.
action 0 menu-next
checkpoint 0 capture title-selection
expect 0 screen title
expect 0 mode adventure

action 1 menu-confirm
checkpoint 1 capture campaign-selection
expect 1 screen campaign
expect 1 level evergrove

# Select Western Falls and launch it through the campaign screen.
action 2 menu-next
checkpoint 2 capture level-selection
expect 2 screen campaign
expect 2 level western-falls

action 3 menu-confirm
expect 3 screen playing
expect 3 mode adventure
expect 3 level western-falls
expect 3 objective objective.find-fallskeeper
expect 3 generation 2
expect 3 publications 1

# Ask Moss about the four marks, then leave the Falls spawn.
action 4 interact
expect 8 objective objective.find-fallskeeper
expect 8 dialogue dialogue.moss.falls

# Close Moss's hint while walking west, then ask the nearby Fallskeeper.
hold 5 39 forward-left
action 40 interact
action 41 interact
expect 45 objective objective.find-tideweave
expect 45 dialogue dialogue.fallskeeper.marks
expect 45 journal journal.fallskeeper-lead

# Follow the original route to the sand seam in front of the sealed Tideweave
# cache. These frames intentionally retain the established navigation proof.
hold 42 94 forward-left
hold 95 100 look-left
action 101 mine
hold 102 137 forward-rise
hold 138 153 rise
expect 155 sand 1
expect 155 position 5,3,21

# Enter the four content-authored marks at the cache. The final mark opens the
# gate before the player can collect Tideweave.
action 156 interact
action 158 interact
expect 159 object-state vault.glyph-river=caxecraft:entered
action 160 interact
expect 161 object-state vault.glyph-leaf=caxecraft:entered
action 162 interact
expect 163 object-state vault.glyph-moon=caxecraft:entered
action 164 interact
expect 165 object-state vault.gate=caxecraft:open
expect 165 dialogue dialogue.vault.open
action 166 interact

# Cross the opened cache, equip Tideweave, and enter the flooded grotto.
hold 167 182 right
expect 186 equipment caxecraft:tideweave-suit
expect 186 objective objective.explore-grotto
expect 186 sand 1
hold 187 242 backward
hold 243 326 left-descend
expect 327 equipment caxecraft:tideweave-suit
expect 327 objective none
expect 327 lanterns 2
expect 327 sand 1
expect 327 medium submerged
expect 327 position 13,3,25
hold 327 358 right-rise

action 364 pause
checkpoint 364 capture final
expect 364 screen paused
expect 364 level western-falls
expect 364 objective none
expect 364 equipment caxecraft:tideweave-suit
expect 364 lanterns 2
expect 364 medium dry
expect 364 position 13,6,22
expect 364 object-state vault.gate=caxecraft:open
end
