PILOSCRIPT 1
name adventure-journey
frames 350

# Move from Creative to Adventure, then open the staged campaign.
action 0 menu-next
checkpoint 0 capture title-selection
expect 0 screen title
expect 0 mode adventure

action 1 menu-confirm
checkpoint 1 capture campaign-selection
expect 1 screen campaign
expect 1 level evergrove

# Select Western Falls and launch it through the campaign screen.
action 2 menu-next
checkpoint 2 capture level-selection
expect 2 screen campaign
expect 2 level western-falls

action 3 menu-confirm
expect 3 screen playing
expect 3 mode adventure
expect 3 level western-falls
expect 3 objective objective.western-falls
expect 3 generation 2
expect 3 publications 1

# Leave the Falls spawn, open the sand seam, and reach the lower cache.
hold 4 91 forward-left
hold 92 97 look-left
action 98 mine
hold 99 134 forward-rise
hold 135 150 rise

# At this point the route has opened the sand seam and equipped Tideweave.
expect 152 sand 1
expect 152 position 5,3,21

# Cross the opened lower cache, equip Tideweave, and enter the flooded grotto.
hold 151 166 right
expect 170 equipment caxecraft:tideweave-suit
expect 170 sand 1
hold 171 226 backward
hold 227 310 left-descend
expect 311 equipment caxecraft:tideweave-suit
expect 311 lanterns 2
expect 311 sand 1
expect 311 medium submerged
expect 311 position 13,3,25
hold 311 342 right-rise

checkpoint 348 capture final
expect 348 screen playing
expect 348 level western-falls
expect 348 objective objective.western-falls
expect 348 equipment caxecraft:tideweave-suit
expect 348 lanterns 2
expect 348 sand 1
expect 348 medium dry
expect 348 position 13,6,22
end
