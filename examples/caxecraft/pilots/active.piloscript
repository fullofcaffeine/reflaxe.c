PILOSCRIPT 1
name adventure-journey
frames 171

# Enter Adventure and launch the campaign's real Evergrove entry level.
action 0 menu-next
checkpoint 0 capture title-selection
expect 0 screen title
expect 0 mode adventure

action 1 menu-confirm
checkpoint 1 capture campaign-selection
expect 1 screen campaign
expect 1 level evergrove

action 2 menu-confirm
checkpoint 2 capture level-selection
expect 2 screen playing
expect 2 mode adventure
expect 2 level evergrove
expect 2 objective objective.prologue
expect 2 generation 2
expect 2 publications 1

# Walk to Nia, receive the western-road objective, and close the dialogue.
hold 3 10 forward
action 11 interact
expect 15 dialogue dialogue.nia.welcome
expect 15 objective objective.explore
checkpoint 15 capture final
action 16 interact
action 17 interact

# Leave through Evergrove's authored west gate. This is the only expectation
# needed for the compact introduction: detailed village tuning remains content.
hold 18 81 left
hold 82 97 backward
hold 98 121 left-jump
expect 126 screen playing
expect 126 level western-falls
expect 126 objective objective.find-fallskeeper
expect 126 generation 3
expect 126 publications 2

hold 127 160 turn-left
action 162 pause
expect 162 screen paused
expect 162 level western-falls
end
