PILOSCRIPT 1
name adventure-journey
frames 395

# Move from Creative to Adventure, then open the staged campaign.
action 0 menu-next
checkpoint 0 capture title-selection
expect 0 screen title
expect 0 mode adventure

action 1 menu-confirm
checkpoint 1 capture campaign-selection
expect 1 screen campaign
expect 1 level evergrove

# Select Western Falls and launch it through the campaign screen.
action 2 menu-next
action 3 menu-next
checkpoint 3 capture level-selection
expect 3 screen campaign
expect 3 level western-falls

action 4 menu-confirm
expect 4 screen playing
expect 4 mode adventure
expect 4 level western-falls
expect 4 objective objective.find-fallskeeper
expect 4 generation 2
expect 4 publications 1

# Ask Moss about the four marks, then leave the Falls spawn.
action 5 interact
expect 9 objective objective.find-fallskeeper
expect 9 dialogue dialogue.moss.falls

# Close Moss's hint while walking west, then ask the nearby Fallskeeper.
hold 6 40 forward-left
action 41 interact
action 42 interact
expect 46 objective objective.find-tideweave
expect 46 dialogue dialogue.fallskeeper.marks
expect 46 journal journal.fallskeeper-lead

# Follow the original route to the sand seam in front of the sealed Tideweave
# cache. These frames intentionally retain the established navigation proof.
hold 43 95 forward-left
hold 96 101 look-left
action 102 mine
hold 103 138 forward-rise
hold 139 154 rise
expect 156 sand 1
expect 156 position 5,3,21

# Enter the four content-authored marks at the cache. The final mark opens the
# gate before the player can collect Tideweave.
action 157 interact
action 159 interact
expect 160 object-state vault.glyph-river=caxecraft:entered
action 161 interact
expect 162 object-state vault.glyph-leaf=caxecraft:entered
action 163 interact
expect 164 object-state vault.glyph-moon=caxecraft:entered
action 165 interact
expect 166 object-state vault.gate=caxecraft:open
expect 166 dialogue dialogue.vault.open
action 167 interact

# Cross the opened cache, equip Tideweave, and enter the flooded grotto.
hold 168 183 right
expect 187 equipment caxecraft:tideweave-suit
expect 187 objective objective.explore-grotto
expect 187 sand 1
hold 188 243 backward
hold 244 327 left-descend
expect 328 equipment caxecraft:tideweave-suit
expect 328 objective none
expect 328 lanterns 2
expect 328 sand 1
expect 328 medium submerged
expect 328 position 13,3,25
hold 328 359 right-rise

# Continue along the western mountain road after solving the grotto. The
# map-authored volume—not a keyboard shortcut—requests Frostmere and publishes it once.
hold 360 385 forward-jump
expect 388 screen playing
expect 388 level frostmere
expect 388 generation 3
expect 388 publications 2

action 390 pause
checkpoint 390 capture final
expect 390 screen paused
expect 390 level frostmere
end
