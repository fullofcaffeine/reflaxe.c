PILOSCRIPT 1
name frostmere-journey
frames 270

# Enter Adventure and select Frostmere from the runtime campaign catalog.
action 0 menu-next
checkpoint 0 capture title-selection

action 1 menu-confirm
checkpoint 1 capture campaign-selection

action 2 menu-next
checkpoint 2 capture level-selection
expect 2 level frostmere

action 3 menu-confirm
expect 3 objective objective.ask-nia

# Nia stands at the arrival shelf and gives the chapter's first direction.
action 4 interact
expect 8 objective objective.wake-ember

# Close Nia's dialogue and climb to the ember marker.
action 9 interact
hold 10 19 right
hold 20 60 forward-jump
hold 61 66 left
action 68 interact
expect 70 object-state snow.ember=caxecraft:entered
expect 71 object-state snow.gate=caxecraft:open
expect 72 objective objective.reach-overlook

# Close the ember message and cross the opened bridge. The three signal stones
# sit on the natural climb in Nia's wave, forge, flame order.
action 73 interact
hold 74 109 forward-jump
action 110 interact
expect 112 object-state signal.wave=caxecraft:entered
hold 111 122 forward-jump
action 123 interact
hold 124 134 forward-jump
action 135 interact
expect 137 object-state signal.gate=caxecraft:open
action 138 interact
hold 139 155 forward-jump
hold 156 160 left
expect 162 objective objective.seek-ashfall
expect 163 lanterns 2
expect 164 journal journal.ashfall-threshold

# Return down the same route. The open bridge must not trap the player at the
# reward shelf, and the optional Mossling must not block the central crossing.
hold 165 221 backward-jump
expect 222 position 16,8,17

action 258 pause
checkpoint 258 capture final
expect 258 screen paused
end
