PILOSCRIPT 1
name castle-courtyard-journey
frames 500

# Enter Adventure and select the castle courtyard from the runtime campaign.
action 0 menu-next
checkpoint 0 capture title-selection
action 1 menu-confirm
checkpoint 1 capture campaign-selection
action 2 menu-next
action 4 menu-next
action 6 menu-next
action 8 menu-next
action 10 menu-next
action 12 menu-next
action 14 menu-next
checkpoint 15 capture level-selection
expect 15 level castle-courtyard
action 16 menu-confirm
expect 18 screen playing
expect 18 mode adventure
expect 18 level castle-courtyard
expect 18 objective objective.read-note
expect 18 generation 2
expect 18 publications 1

# Read Ceesh's fresh field note on the western edge of the arrival road.
hold 19 34 forward-left
action 36 interact
expect 40 object-state castle.ceesh-note=caxecraft:entered
expect 40 objective objective.set-controls
action 41 interact
action 46 interact

# Set the west counterweight, then cross the broad approach to the east relay.
# The controls intentionally accept either order; this route proves one real
# order without turning both permutations into permanent content automation.
hold 47 83 left
hold 84 93 forward
action 95 interact
expect 99 object-state castle.west-winch=caxecraft:entered
action 100 interact
action 105 interact
hold 106 205 right
action 207 interact
expect 211 object-state castle.east-relay=caxecraft:entered
action 214 interact
action 219 interact
expect 221 object-state castle.outer-gate=caxecraft:open
expect 221 objective objective.enter-keep
action 224 interact
action 229 interact

# Return to the dry central causeway, pass the opened outer gate, and stop at
# the still-sealed inner keep. Browser remains off-stage in this chapter.
hold 233 285 left
hold 289 359 forward
action 362 interact
expect 367 object-state castle.inner-lock=caxecraft:entered
expect 368 objective objective.enter-underworks
expect 369 journal journal.inner-keep
action 370 interact
action 376 interact

# Continue through the opened maintenance bypass. The existing executable loads
# the new reloadable level through the campaign transition at runtime.
hold 380 390 right
hold 394 427 forward
hold 431 449 left
hold 452 484 forward
action 491 pause
checkpoint 491 capture final
expect 491 screen paused
expect 491 level castle-underworks
expect 491 objective objective.isolate-wing
end
