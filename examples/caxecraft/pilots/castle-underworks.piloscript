PILOSCRIPT 1
name castle-underworks-journey
frames 272

# Enter Adventure and choose Castle Underworks from reloadable campaign data.
action 0 menu-next
checkpoint 0 capture title-selection
action 1 menu-confirm
checkpoint 1 capture campaign-selection
action 2 menu-next
action 4 menu-next
action 6 menu-next
action 8 menu-next
action 10 menu-next
action 12 menu-next
checkpoint 13 capture level-selection
expect 13 level castle-underworks
action 14 menu-confirm
expect 22 screen playing
expect 22 mode adventure
expect 22 level castle-underworks
expect 22 objective objective.isolate-wing

# Hear Ceesh's plan, then take the safer coolant gallery around the sabotaged
# lift. The ash-vent alternative remains a free-play choice, not a duplicate
# permanent journey.
hold 15 34 forward
action 36 interact
action 41 interact
hold 42 71 turn-left
hold 72 112 forward
hold 114 143 turn-right
hold 144 247 forward
action 249 interact
expect 252 objective objective.reach-archive
expect 252 object-state underworks.coolant-relay=caxecraft:entered
expect 253 object-state underworks.archive-gate=caxecraft:open
action 254 interact
checkpoint 257 capture final
end
