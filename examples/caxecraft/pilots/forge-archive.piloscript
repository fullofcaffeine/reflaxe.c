PILOSCRIPT 1
name forge-archive-journey
frames 70

# Enter Adventure, select the reloadable Forge Archive, and meet Ceesh at the
# main line.
action 0 menu-next
checkpoint 0 capture title-selection
action 1 menu-confirm
checkpoint 1 capture campaign-selection
action 2 menu-next
action 4 menu-next
checkpoint 5 capture level-selection
action 6 menu-confirm
expect 20 screen playing
expect 20 mode adventure
expect 20 level forge-archive
expect 20 objective objective.join-ceesh
hold 21 32 forward
action 34 interact
action 39 interact
action 44 interact
expect 45 objective objective.restore-branches
expect 45 object-state archive.ceesh-line=caxecraft:entered
checkpoint 60 capture final
end
